# Safe defaults: credentials are configured in Hostinger, never committed.
SITE_ENV=staging
DEPLOY_TARGET=hostinger
HOST=0.0.0.0
PUBLIC_SITE_URL=https://lorenmichaelsharris.com
# Exact temporary hostname only, if Hostinger provides one (no protocol).
HOSTINGER_PREVIEW_HOST=
FORM_ADAPTER=unavailable
FORMS_APPROVED=false
LOCAL_TEST_MODE=false
INQUIRY_TO=hello@lorenmichaelsharris.com
RESEND_API_KEY=
RESEND_FROM=
RECEIPT_SECRET=
NEWSLETTER_SEGMENT_ID=
# Legacy adapters retained for compatibility; not needed for Resend.
INQUIRY_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_URL=
FORM_WEBHOOK_TOKEN=

# Private dashboard and guest booking (configure only in Hostinger).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
ADMIN_EMAIL=hello@lorenmichaelsharris.com
CALENDLY_API_TOKEN=
# Optional explicit event URIs; normally resolved from the two scheduling links.
CALENDLY_SHOW_EVENT_URI=
CALENDLY_DISCOVERY_EVENT_URI=
GUEST_BOOKING_ENABLED=false
# Enable for the first approved, backed-up migration; turn off afterward.
DASHBOARD_AUTO_MIGRATE=false
