# Default is an honest unavailable state. Local simulation never sends mail.
SITE_ENV=staging
FORM_ADAPTER=unavailable
LOCAL_TEST_MODE=false
# Production webhook must accept JSON, return 2xx only on accepted delivery,
# implement durable idempotency using the Idempotency-Key header.
INQUIRY_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_URL=
FORM_WEBHOOK_TOKEN=
# Confirm C04/C17 and host before enabling live forms.
FORMS_APPROVED=false

# New inquiry adapter: set FORM_ADAPTER=resend after verifying the sending domain.
RESEND_API_KEY=
RESEND_FROM=
# Random secret, at least 32 bytes; signs expiring confirmation cookies.
RECEIPT_SECRET=
# Newsletter delivery retains the separate consent-aware webhook above.
