---
import {showCalendar,discoveryCalendar} from '../lib/dashboard/calendly';
interface Props {token?:string;name?:string;email?:string;showStart?:string;discoveryStart?:string;showRescheduleUrl?:string;discoveryRescheduleUrl?:string;}
const {token='',name='',email='',showStart='',discoveryStart='',showRescheduleUrl='',discoveryRescheduleUrl=''}=Astro.props;
const fallback=(url:string)=>token?url+'?name='+encodeURIComponent(name)+'&email='+encodeURIComponent(email)+'&utm_content='+encodeURIComponent(token.split('.')[0]):url;
---
<section class="guest-booking-flow" data-guest-booking data-token={token} data-name={name} data-email={email} data-show-start={showStart} data-discovery-start={discoveryStart} data-show-reschedule={showRescheduleUrl} data-discovery-reschedule={discoveryRescheduleUrl} hidden={!token} aria-label="Guest scheduling">
 <div data-show-step><p class="eyebrow">STEP 2 · RESERVE YOUR SHOW DATE</p><h2>Your place in the conversation.</h2><p>Your application was received. Choose your broadcast date below. Shows run Monday–Friday at 10 AM Chicago time.</p><p class="form-note">Calendly may display times in your local time zone. Check its time-zone selector before booking.</p><div class="calendly-mount" data-calendar-kind="show" data-calendar-url={showCalendar}></div><a data-calendar-fallback="show" href={fallback(showCalendar)} target="_blank" rel="noopener noreferrer">Open the show calendar in a new tab ↗</a></div>
 <div data-discovery-step hidden={!showStart}><p class="eyebrow">NEXT · YOUR PRE-SHOW DISCOVERY CALL</p><h2>Let’s meet before the show.</h2><p data-show-confirmation></p><p>Book your 15-minute discovery call <strong>before your broadcast date</strong>. We’ll discuss your story and prepare for the conversation.</p><div class="calendly-mount" data-calendar-kind="discovery" data-calendar-url={discoveryCalendar}></div><a data-calendar-fallback="discovery" href={fallback(discoveryCalendar)} target="_blank" rel="noopener noreferrer">Open the discovery calendar in a new tab ↗</a></div>
 <p data-reschedule-note hidden><a data-reschedule-link target="_blank" rel="noopener noreferrer">Reschedule your discovery call before the show ↗</a></p><p class="booking-status" role="status" aria-live="polite"></p><p class="form-note">If verification is delayed, your Calendly reservation still exists. Keep its confirmation email and contact hello@lorenmichaelsharris.com. The team reviews episode details before publication.</p><p><a data-resume-link href={token?`/bathrobe-moments/booking/?token=${encodeURIComponent(token)}`:undefined}>Save this private link to finish scheduling later</a></p>
 <noscript><p>Use the show-calendar link above, then the discovery-calendar link. Keep the booking confirmations and use the same email as your application so the team can match your reservations.</p><a href={fallback(discoveryCalendar)}>Book discovery before your show ↗</a></noscript>
</section>
<script>
interface CalendlyWindow extends Window {Calendly?:{initInlineWidget(options:Record<string,unknown>):void};}
const w=window as CalendlyWindow;let loading:Promise<void>|undefined;
function load(){if(w.Calendly)return Promise.resolve();return loading??=new Promise<void>((resolve,reject)=>{const script=document.createElement('script');script.src='https://assets.calendly.com/assets/external/widget.js';script.onload=()=>resolve();script.onerror=()=>reject();document.head.append(script);});}
export function openGuestBooking(root:HTMLElement,token:string,name:string,email:string){root.hidden=false;root.dataset.token=token;root.dataset.name=name;root.dataset.email=email;const resume=root.querySelector<HTMLAnchorElement>('[data-resume-link]')!;resume.href='/bathrobe-moments/booking/?token='+encodeURIComponent(token);void initialize(root);}
async function initialize(root:HTMLElement){const status=root.querySelector<HTMLElement>('.booking-status')!;const show=root.querySelector<HTMLElement>('[data-show-step]')!,discovery=root.querySelector<HTMLElement>('[data-discovery-step]')!;const date=(s:string)=>new Intl.DateTimeFormat('en-US',{timeZone:'America/Chicago',dateStyle:'full',timeStyle:'short'}).format(new Date(s))+' Chicago time';
 root.querySelectorAll<HTMLAnchorElement>('[data-calendar-fallback]').forEach(link=>{const url=new URL(link.dataset.calendarFallback==='show'?'https://calendly.com/lorenmichaelsharris/bathrobe-moments':'https://calendly.com/lorenmichaelsharris/15min');url.searchParams.set('name',root.dataset.name||'');url.searchParams.set('email',root.dataset.email||'');url.searchParams.set('utm_content',root.dataset.token?.split('.')[0]||'');link.href=url.href;});
 if(root.dataset.showStart){show.hidden=true;show.querySelector('.calendly-mount')?.replaceChildren();discovery.hidden=false;root.querySelector<HTMLElement>('[data-show-confirmation]')!.textContent='Show reserved: '+date(root.dataset.showStart);}
 if(root.dataset.discoveryStart){const before=!!root.dataset.showStart&&Date.parse(root.dataset.discoveryStart)<Date.parse(root.dataset.showStart);status.textContent=before?'Discovery booked: '+date(root.dataset.discoveryStart)+'. The team will review your episode details.':'Your discovery call must be rescheduled before your show. Use your Calendly confirmation to reschedule.';discovery.querySelector<HTMLElement>('.calendly-mount')!.hidden=true;if(root.dataset.discoveryReschedule){const note=root.querySelector<HTMLElement>('[data-reschedule-note]')!;note.hidden=false;root.querySelector<HTMLAnchorElement>('[data-reschedule-link]')!.href=root.dataset.discoveryReschedule;}}
 try{await load();const kind=root.dataset.showStart?'discovery':'show';if(kind==='discovery'&&root.dataset.discoveryStart)return;const mount=root.querySelector<HTMLElement>(`[data-calendar-kind="${kind}"]`)!;if(!mount.dataset.loaded){mount.dataset.loaded='true';w.Calendly!.initInlineWidget({url:mount.dataset.calendarUrl+'?hide_gdpr_banner=0&primary_color=d6b24d',parentElement:mount,prefill:{name:root.dataset.name,email:root.dataset.email},utm:{utmContent:root.dataset.token?.split('.')[0]}});}}catch{status.textContent='The embedded calendar could not load. Use the calendar link to continue.';}
}
document.querySelectorAll<HTMLElement>('[data-guest-booking]').forEach(root=>{if(!root.hidden)void initialize(root);root.addEventListener('guest-application-accepted',e=>{const d=(e as CustomEvent).detail;openGuestBooking(root,d.token,d.name,d.email);});});
window.addEventListener('message',async e=>{if(e.origin!=='https://calendly.com'||e.data?.event!=='calendly.event_scheduled')return;const root=[...document.querySelectorAll<HTMLElement>('[data-guest-booking]')].find(r=>!r.hidden&&[...r.querySelectorAll('iframe')].some(frame=>frame.contentWindow===e.source));if(!root)return;const status=root.querySelector<HTMLElement>('.booking-status')!;status.textContent='Verifying your reservation…';const kind=root.dataset.showStart?'discovery':'show';try{const r=await fetch('/api/guest/booking/',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({token:root.dataset.token,kind,uri:e.data.payload?.invitee?.uri})});const result=await r.json();if(!r.ok)throw new Error(result.error);root.dataset.showStart=result.show?.status==='active'?result.show.start:'';root.dataset.discoveryReschedule=result.discovery?.rescheduleUrl||'';root.dataset.showReschedule=result.show?.rescheduleUrl||'';root.dataset.discoveryStart=result.discovery?.status==='active'?result.discovery.start:'';status.textContent='Your reservation has been verified.';await initialize(root);root.querySelector<HTMLElement>('[data-discovery-step] h2')?.setAttribute('tabindex','-1');root.querySelector<HTMLElement>('[data-discovery-step] h2')?.focus({preventScroll:true});}catch(error){status.textContent=(error instanceof Error?error.message:'Verification is unavailable.')+' Keep your Calendly confirmation. The team can verify it.';}});
</script>
<style>.guest-booking-flow{padding:32px;border:1px solid var(--line);border-radius:18px;margin-block:32px}.guest-booking-flow h2{font-size:clamp(36px,4vw,56px)}.calendly-mount{min-width:0;min-height:760px;margin:24px 0;background:#fff;border-radius:12px;overflow:hidden}.booking-status{padding-block:18px;color:var(--gold)}@media(max-width:600px){.guest-booking-flow{padding:24px 0;margin-inline:-20px;border-inline:0;border-radius:0}.calendly-mount{min-height:940px;border-radius:0}}</style>
