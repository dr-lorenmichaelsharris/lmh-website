---
import {publicEpisodes} from '../lib/dashboard/public';import {monday,addDays,chicagoDate,broadcastStart} from '../lib/dashboard/time';
interface Props {compact?:boolean;standalone?:boolean;}
const {compact=false,standalone=false}=Astro.props;const {items,available}=await publicEpisodes();const current=monday();const today=chicagoDate();const next=Astro.url.searchParams.get('week')==='next'||(!Astro.url.searchParams.has('week')&&(today>addDays(current,4)||(today===addDays(current,4)&&Date.now()>=Date.parse(broadcastStart(today))+3600000)));const start=addDays(current,next?7:0);const days=Array.from({length:5},(_,i)=>addDays(start,i));const pretty=(date:string)=>new Intl.DateTimeFormat('en-US',{month:'short',day:'numeric',timeZone:'UTC'}).format(new Date(date+'T12:00:00Z'));const lineup=items.filter(e=>e.date>=start&&e.date<=addDays(start,4)).sort((a,b)=>a.date.localeCompare(b.date));
---
<section class:list={['section weekly-lineup',{'lineup-compact':compact,'lineup-standalone':standalone}]} id="weekly-lineup"><div class="wrap"><div class="section-heading"><div>{!standalone&&<><p class="eyebrow">BATHROBE MOMENTS · YOUR WEEKLY LINEUP</p><h2>Five days.<br/><em>Room for real conversation.</em></h2></>}<p>{pretty(start)}–{pretty(addDays(start,4))} · Monday–Friday · 10 AM Chicago time</p></div>{!standalone&&<a class="text-link" href="/bathrobe-moments/schedule/">View the show schedule ↗</a>}</div>{!compact&&<nav class="week-tabs" aria-label="Choose show week"><a href="?week=this#weekly-lineup" aria-current={!next?'page':undefined}>This Week</a><a href="?week=next#weekly-lineup" aria-current={next?'page':undefined}>Next Week</a></nav>}{available&&(!compact||lineup.length>0)?<div class="weekly-grid">{days.map((date,i)=>{const e=lineup.find(e=>e.date===date&&!e.cancelled)||lineup.find(e=>e.date===date);return <article class="weekly-slot"><p class="eyebrow">{['MONDAY','TUESDAY','WEDNESDAY','THURSDAY','FRIDAY'][i]} · {pretty(date)}</p>{e?<><a href={`/bathrobe-moments/episodes/${e.slug}/`}><img src={e.banner} alt={`${e.guest} show banner`} width="640" height="360" loading="lazy"/></a><h3><a href={`/bathrobe-moments/episodes/${e.slug}/`}>{e.guest}</a></h3><p>{e.title}</p><p class="metadata">{e.cancelled?'Canceled':e.previousDate?'Rescheduled':'10 AM Central'}</p><a class="text-link" href={`/bathrobe-moments/episodes/${e.slug}/`}>Episode details ↗</a></>:<><h3>Lineup to be announced.</h3><p>Check back for the confirmed guest and conversation.</p></>}</article>;})}</div>:<div class="lineup-notice"><p>The next guests will appear here once confirmed. Until then, explore the published conversations.</p><a class="text-link" href="/bathrobe-moments/episodes/">Explore the episode archive ↗</a></div>}<div class="actions"><a class="text-link" href="/bathrobe-moments/episodes/">Past conversations ↗</a><a class="text-link" href="/bathrobe-moments/#application">Share your story ↗</a></div></div></section>
