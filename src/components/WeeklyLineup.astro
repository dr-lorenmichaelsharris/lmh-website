---
import {publicEpisodes} from '../lib/dashboard/public';import {monday,addDays,broadcastStart} from '../lib/dashboard/time';import {selectedWeek} from '../lib/dashboard/presentation';import EpisodeCard from './EpisodeCard.astro';
interface Props {compact?:boolean;standalone?:boolean;}
const {compact=false,standalone=false}=Astro.props;const {items,available}=await publicEpisodes();const start=selectedWeek(Astro.url),current=monday();
const pretty=(date:string)=>new Intl.DateTimeFormat('en-US',{month:'short',day:'numeric',year:'numeric',timeZone:'UTC'}).format(new Date(date+'T12:00:00Z'));
const lineup=items.filter(e=>e.date>=start&&e.date<=addDays(start,4)).sort((a,b)=>a.date.localeCompare(b.date));const upcoming=items.filter(e=>e.date&&!e.cancelled&&Date.parse(broadcastStart(e.date))+3600000>Date.now()).sort((a,b)=>a.date.localeCompare(b.date));const next=upcoming[0];const empty=Array.from({length:5},(_,i)=>addDays(start,i)).filter(d=>!lineup.some(e=>e.date===d));
---
<section class:list={['section weekly-lineup','lineup-v8',{'lineup-compact':compact,'lineup-standalone':standalone}]} id="weekly-lineup"><div class="wrap"><div class="section-heading"><div>{!standalone&&<><p class="eyebrow">BATHROBE MOMENTS · THE LINEUP</p><h2>Next on the show.</h2></>}<p>Monday–Friday · 10 AM Chicago time</p></div>{!standalone&&<a class="text-link" href="/bathrobe-moments/schedule/">Full schedule ↗</a>}</div>{!available?<div class="lineup-notice" role="status"><h3>The lineup is temporarily unavailable.</h3><p>Please try again shortly. No guest details have been changed.</p></div>:<>{next&&<EpisodeCard episode={next} featured/>}{!compact&&<><div class="lineup-week-heading"><div><p class="eyebrow">WEEKLY LINEUP</p><h3>{pretty(start)} – {pretty(addDays(start,4))}</h3></div><nav class="week-tabs" aria-label="Choose show week"><a href="?week=this#weekly-lineup" aria-current={start===current?'page':undefined}>This Week</a><a href="?week=next#weekly-lineup" aria-current={start===addDays(current,7)?'page':undefined}>Next Week</a><a href={`?date=${addDays(start,-7)}#weekly-lineup`} aria-label="Previous week">← Previous week</a><a href={`?date=${addDays(start,7)}#weekly-lineup`} aria-label="Following week">Following week →</a></nav></div>{lineup.length?<><div class="lineup-scroll-controls" data-lineup-controls hidden><button type="button" data-direction="-1" aria-label="Previous episode cards">←</button><button type="button" data-direction="1" aria-label="Next episode cards">→</button></div><div class="weekly-banner-grid" data-weekly-cards tabindex="0" aria-label="Episodes this week">{lineup.map(e=><EpisodeCard episode={e}/>)}</div>{empty.length>0&&<p class="lineup-unannounced">{empty.map(d=>new Intl.DateTimeFormat('en-US',{weekday:'long',timeZone:'UTC'}).format(new Date(d+'T12:00:00Z'))).join(', ')}: guests to be announced.</p>}</>:<div class="lineup-notice"><h3>No episodes announced for this week yet.</h3><p>Confirmed conversations will appear here after publication.</p><div class="actions"><a href="/bathrobe-moments/schedule/#upcoming">See all upcoming episodes ↓</a><a href="/bathrobe-moments/episodes/">Explore past conversations ↗</a></div></div>}</>}{compact&&!next&&<p class="lineup-notice">New guests will appear here once confirmed. Until then, explore past conversations.</p>}{standalone&&<section id="upcoming" class="all-upcoming"><p class="eyebrow">PLAN AHEAD</p><h2>All upcoming episodes.</h2>{upcoming.length?<div class="episode-grid">{upcoming.map(e=><EpisodeCard episode={e}/>)}</div>:<p>No upcoming episodes have been published yet. Check back for the next guests.</p>}</section>}</>}<div class="actions"><a class="text-link" href="/bathrobe-moments/episodes/">Past conversations ↗</a><a class="text-link" href="/bathrobe-moments/#application">Share your story ↗</a></div></div></section>
<script>document.querySelectorAll<HTMLElement>('.lineup-v8').forEach(root=>{const row=root.querySelector<HTMLElement>('[data-weekly-cards]');const controls=root.querySelector<HTMLElement>('[data-lineup-controls]');if(!row||!controls)return;controls.hidden=false;controls.querySelectorAll<HTMLButtonElement>('button').forEach(button=>button.addEventListener('click',()=>row.scrollBy({left:Number(button.dataset.direction)*row.clientWidth*.85,behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'})));});</script>
