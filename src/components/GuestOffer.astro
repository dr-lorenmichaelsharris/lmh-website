---
import {guestCampaignActive} from '../lib/guest-campaign';
const free=guestCampaignActive();
---
<div class="guest-offer"><p class="eyebrow">{free?'AN INVITATION TO SHARE':'YOUR NEXT CONVERSATION'}</p><h3>{free?'Your story deserves a seat.':'Let’s discuss your appearance.'}</h3><p>{free?'Free guest appearances through January 1, 2027. Apply, reserve your show date, then schedule discovery before your broadcast.':'Applications are open. Appearance arrangements and any fees are discussed during your discovery call.'}</p><p class="metadata">Subject to fit and availability. Applying does not confirm an appearance.</p></div>
