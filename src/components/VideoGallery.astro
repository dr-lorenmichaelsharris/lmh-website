---
interface Clip {title:string;poster:string;videoId?:string;src?:string;source?:string;previewStartRatio?:number;previewSeconds?:number;}
interface Props {title:string;eyebrow?:string;description?:string;clips:Clip[];portrait?:boolean;motion?:'auto'|'manual';}
const {title,eyebrow,description,clips,portrait=false,motion='auto'}=Astro.props;
---
<section class:list={['section video-gallery',{'portrait-gallery':portrait,'conversation-gallery':!portrait}]} data-carousel={motion}>
<div class="wrap section-heading"><div>{eyebrow&&<p class="eyebrow">{eyebrow}</p>}<h2>{title}</h2>{description&&<p class="video-gallery-description">{description}</p>}</div><div class="gallery-actions"><button data-carousel-pause data-media-pause class="round-control media-pause" hidden aria-label="Pause gallery and previews" title="Pause gallery and previews" aria-pressed="false"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><g class="pause-symbol"><rect x="6" y="4" width="4" height="16" rx="1"/><rect x="14" y="4" width="4" height="16" rx="1"/></g><path class="play-symbol" d="M8 4v16l13-8z"/></svg></button><button data-carousel-step="-1" class="round-control" hidden aria-label="Previous videos">←</button><button data-carousel-step="1" class="round-control" hidden aria-label="Next videos">→</button></div></div>
<div class="video-row" data-carousel-row tabindex="0" aria-label={title}><div class="video-track">{clips.map(clip=><article class="story-card" data-carousel-card data-video-id={clip.videoId} data-video-src={clip.src} data-video-title={clip.title} data-preview-ratio={clip.previewStartRatio} data-preview-seconds={clip.previewSeconds}>
<div class="story-visual"><img src={clip.poster} alt="" loading="lazy" width={portrait?365:640} height={portrait?460:360}/><div class="silent-preview" aria-hidden="true"></div></div>
<a class="story-expand" data-watch href={clip.src||`https://www.youtube.com/watch?v=${clip.videoId}`} target="_blank" rel="noopener noreferrer" aria-label={`Watch ${clip.title}`} title={`Watch ${clip.title}`}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6M20 4l-7 7M10 20H4v-6M4 20l7-7"/></svg></a>
<div class="story-caption">{portrait&&<div class="story-stars" aria-hidden="true">{Array.from({length:5},()=> <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="m12 2 3.1 6.3 7 .9-5.1 5 1.2 7-6.2-3.3-6.2 3.3 1.2-7-5.1-5 7-.9z"/></svg>)}</div>}<h3>{clip.title}</h3></div>
</article>)}</div></div><slot/>
</section>
<script>
import {setupCarousels} from '../scripts/carousels';
import {setupVideoCards} from '../scripts/video-cards';
setupCarousels();setupVideoCards();
</script>
