---
interface Props {eyebrow?:string;title:string;description?:string;}
const {eyebrow='LOREN MICHAELS HARRIS',title,description}=Astro.props;
---
<section class="page-intro wrap"><p class="eyebrow">{eyebrow}</p><h1>{title}</h1>{description&&<p class="intro-description">{description}</p>}<slot/></section>
