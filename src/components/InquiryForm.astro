---
import GuestBooking from './GuestBooking.astro';
import {bookingEnabled} from '../lib/dashboard/guest';
import {site} from '../data/site';
interface Props {service?:string;values?:Record<string,string>;errors?:Record<string,string>;dynamic?:boolean;}
const {service='general',values={},errors={},dynamic=false}=Astro.props;
const value=(key:string)=>values[key]||'';
const choices=[['general','General & media'],['speaking','Keynote speaking & events'],['coaching','Coaching'],['keynote-writing','Keynote writing'],['program','The Mindset Revolution'],['guest','Bathrobe Moments guest application']];
const fields:Record<string,string[][]>={speaking:[['organization','Organization'],['eventDate','Event date or “undecided”'],['location','Location or virtual'],['audience','Who is the audience?'],['outcome','What would you like the audience to take away?']], 'keynote-writing':[['occasion','Occasion'],['audience','Audience'],['talkLength','Talk length'],['deadline','Deadline'],['material','Starting material'],['scope','Scope you have in mind']],coaching:[['focus','What would you like to work on?'],['format','Preferred format (if known)']],program:[['focus','What brings you to The Mindset Revolution?']],guest:[['phone','Phone (optional)'],['website','Website or social profile (optional)']],general:[]};
const groups=dynamic?choices:choices.filter(([id])=>id===service);
---
{dynamic&&<noscript><form method="get" action="/contact/#inquiry"><label for="plain-service">What would you like to discuss?</label><select name="service" id="plain-service">{choices.map(([id,label])=><option value={id} selected={service===id}>{label}</option>)}</select><button class="button" type="submit">Show relevant fields ↓</button></form></noscript>}
<form class="inquiry-form" action="/api/submit/" method="post" enctype="multipart/form-data" id="inquiry" data-booking-enabled={String(bookingEnabled())} data-dynamic={dynamic?'true':'false'}><input type="hidden" name="service" value={service}/>{dynamic&&<div class="dynamic-choice" hidden><label for="inquiry-type">What would you like to discuss?</label><select id="inquiry-type">{choices.map(([id,label])=><option value={id} selected={service===id}>{label}</option>)}</select><p class="form-note" role="status" id="service-status">The relevant fields appear below. Your details stay here when you switch.</p></div>}<p class="form-note">Fields marked * are required. Submitting an inquiry does not confirm an engagement.</p>{Object.keys(errors).length>0&&<div class="error-summary" role="alert" tabindex="-1"><h2>Please check your details</h2><ul>{Object.entries(errors).map(([key,message])=><li><a href={`#field-${key}`}>{message}</a></li>)}</ul></div>}
<div class="form-grid">{([['name','Your name','text','name'],['email','Email address','email','email']] as const).map(([key,label,type,autocomplete])=><div><label for={`field-${key}`}>{label} *</label><input id={`field-${key}`} name={key} type={type} autocomplete={autocomplete} required maxlength={key==='email'?254:120} value={value(key)} aria-invalid={errors[key]?'true':undefined}/>{errors[key]&&<p class="field-error">{errors[key]}</p>}</div>)}</div>
{groups.map(([id,label])=><fieldset data-service-fields={id} hidden={id!==service} disabled={id!==service}><legend>{label}</legend><div class="form-grid">{(fields[id]||[]).map(([key,label])=><div class="field-group"><label for={`field-${id}-${key}`}>{label}</label><input id={`field-${id}-${key}`} name={key} type={key==='phone'?'tel':key==='website'?'url':'text'} maxlength="500" value={id===service?value(key):''}/></div>)}</div>{id==='guest'&&<><div class="field-group"><label for="field-headshot">Professional headshot *</label><input type="file" name="headshot" id="field-headshot" accept="image/jpeg,image/png,image/webp" required aria-describedby="headshot-help"/><p id="headshot-help" class="form-note">JPEG, PNG or WebP. Maximum 2 MB. Sent privately with your application.</p>{Object.keys(errors).length>0&&<p class="form-note">Please select your headshot again before retrying.</p>}{errors.headshot&&<p class="field-error">{errors.headshot}</p>}</div><div class="field-group"><label for="field-topic">What story, message, or topic would you like to share? *</label><textarea id="field-topic" name="topic" required minlength="10" maxlength="5000" rows="5">{value('topic')}</textarea>{errors.topic&&<p class="field-error">{errors.topic}</p>}</div></>}</fieldset>)}
<label for="field-message" data-message-label>{service==='guest'?'Briefly introduce yourself':'Tell us a little about what you have in mind'} *</label><textarea id="field-message" name="message" required minlength="10" maxlength="5000" rows="6" aria-invalid={errors.message?'true':undefined}>{value('message')}</textarea>{errors.message&&<p class="field-error">{errors.message}</p>}
<input type="hidden" name="lmh_submission_check" value="" autocomplete="off"/>
<label class="check"><input id="field-acknowledgment" type="checkbox" name="acknowledgment" value="yes" required checked={value('acknowledgment')==='yes'}/><span>I have read the <a href="/privacy-policy/">privacy information</a> and <a href="/terms-and-conditions/">terms</a> and want a reply to this inquiry. *</span></label>
<div data-guest-next hidden={service!=='guest'}><p>Your details are stored privately to manage your application and bookings. First submit your application. Then reserve your show date here and book a 15-minute discovery call before your broadcast.</p><p class="form-note">An application or discovery call does not confirm an appearance.</p></div><button class="button" type="submit">{service==='guest'?'Submit guest application':'Send inquiry'} ↗</button><p class="form-note">Prefer a conversation? <a href={site.calendly}>Schedule a call ↗</a><br/>If online delivery is unavailable, email <a href={`mailto:${site.email}`}>{site.email}</a>.</p></form>
<GuestBooking/>
<script>
document.querySelectorAll<HTMLFormElement>('.inquiry-form').forEach(form=>{const service=form.querySelector<HTMLInputElement>('input[name=service]')!;const select=form.querySelector<HTMLSelectElement>('#inquiry-type');const button=form.querySelector<HTMLButtonElement>('button[type=submit]')!;const message=form.querySelector<HTMLTextAreaElement>('[name=message]')!;const drafts:Record<string,string>={};let current=service.value;
const reset=()=>{button.disabled=false;button.textContent=service.value==='guest'?'Submit guest application ↗':'Send inquiry ↗';form.removeAttribute('aria-busy');};
if(select){form.querySelector<HTMLElement>('.dynamic-choice')!.hidden=false;select.addEventListener('change',()=>{drafts[current]=message.value;current=select.value;message.value=drafts[current]??'';service.value=current;form.querySelectorAll<HTMLFieldSetElement>('[data-service-fields]').forEach(group=>{group.hidden=group.dataset.serviceFields!==current;group.disabled=group.hidden;});form.querySelector<HTMLElement>('[data-message-label]')!.textContent=(current==='guest'?'Briefly introduce yourself':'Tell us a little about what you have in mind')+' *';form.querySelector<HTMLElement>('[data-guest-next]')!.hidden=current!=='guest';form.querySelector('#service-status')!.textContent=`Showing ${select.selectedOptions[0].textContent}. Your name and email have been kept.`;const url=new URL(location.href);url.searchParams.set('service',current);history.replaceState(null,'',url);reset();});}
form.addEventListener('submit',async event=>{const file=form.querySelector<HTMLInputElement>('input[type=file]');if(service.value==='guest'&&file?.files?.[0]&&file.files[0].size>2*1024*1024){event.preventDefault();file.setCustomValidity('Choose a headshot smaller than 2 MB.');file.reportValidity();return;}button.disabled=true;button.textContent='Sending…';form.setAttribute('aria-busy','true');if(service.value==='guest'&&form.dataset.bookingEnabled==='true'){event.preventDefault();let summary=form.querySelector<HTMLElement>('.guest-submit-status');if(!summary){summary=document.createElement('div');summary.className='guest-submit-status error-summary';summary.setAttribute('role','alert');summary.tabIndex=-1;form.prepend(summary);}summary.textContent='';try{const response=await fetch(form.action,{method:'POST',headers:{Accept:'application/json'},body:new FormData(form)});const result=await response.json();if(!response.ok||!result.accepted)throw new Error(result.errors?Object.values(result.errors).join(' '):result.message||'Your application could not be delivered. Please retry.');if(!result.token)throw new Error(result.message||'The team will help arrange your show date.');const root=form.nextElementSibling as HTMLElement;form.hidden=true;root.dispatchEvent(new CustomEvent('guest-application-accepted',{detail:{token:result.token,name:(form.querySelector('[name=name]') as HTMLInputElement).value,email:(form.querySelector('[name=email]') as HTMLInputElement).value}}));root.scrollIntoView({behavior:'instant',block:'start'});const heading=root.querySelector<HTMLElement>('h2');heading?.setAttribute('tabindex','-1');heading?.focus({preventScroll:true});}catch(error){summary.textContent=error instanceof Error?error.message:'Please retry or email the team.';summary.focus();}finally{reset();}}});form.querySelector('input[type=file]')?.addEventListener('change',e=>(e.target as HTMLInputElement).setCustomValidity(''));window.addEventListener('pageshow',reset);
});
</script>
