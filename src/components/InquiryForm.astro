---
import {site,packages} from '../data/site';
interface Props {service?:string;values?:Record<string,string>;errors?:Record<string,string>;}
const {service='general',values={},errors={}}=Astro.props;
const value=(key:string)=>values[key]||'';
const fields= service==='speaking'?[['organization','Organization'],['eventDate','Event date or “undecided”'],['location','Location or virtual'],['audience','Who is the audience?'],['outcome','What would you like the audience to take away?']]:service==='keynote-writing'?[['occasion','Occasion'],['audience','Audience'],['talkLength','Talk length'],['deadline','Deadline'],['material','Starting material'],['scope','Scope you have in mind']]:service==='guest'?[['phone','Phone (optional)'],['website','Website or social profile'],['topic','Proposed conversation topic']]:service==='coaching'?[['focus','What would you like to work on?'],['format','Preferred format (if known)']]:service==='program'?[['focus','What brings you to The Mindset Revolution?']]:[];
---
<form class="inquiry-form" action="/api/submit/" method="post" id="inquiry"><input type="hidden" name="service" value={service}/><p class="form-note">Fields marked * are required. Submitting an inquiry does not confirm an engagement.</p>{Object.keys(errors).length>0&&<div class="error-summary" role="alert"><h2>Please check your details</h2><ul>{Object.entries(errors).map(([key,message])=><li><a href={`#field-${key}`}>{message}</a></li>)}</ul></div>}
<div class="form-grid">{([['name','Your name','text','name'],['email','Email address','email','email']] as const).map(([key,label,type,autocomplete])=><div><label for={`field-${key}`}>{label} *</label><input id={`field-${key}`} name={key} type={type} autocomplete={autocomplete} required maxlength={key==='email'?254:120} value={value(key)} aria-invalid={errors[key]?'true':undefined} aria-describedby={errors[key]?`error-${key}`:undefined}/>{errors[key]&&<p id={`error-${key}`} class="field-error">{errors[key]}</p>}</div>)}{fields.map(([key,label])=><div><label for={`field-${key}`}>{label}</label><input id={`field-${key}`} name={key} maxlength="500" value={value(key)}/></div>)}</div>
{service==='guest'&&<div><label for="field-package">Package preference (optional)</label><select id="field-package" name="package"><option value="">Discuss options with me</option>{packages.map(p=><option value={p.id} selected={value('package')===p.id}>{p.name} — request details</option>)}</select><p class="form-note">A preference is not an order or a payment. Options will be discussed as part of your inquiry.</p>{errors.package&&<p class="field-error">{errors.package}</p>}</div>}
<label for="field-message">{service==='guest'?'Introduce yourself and your story':'Tell us a little about what you have in mind'} *</label><textarea id="field-message" name="message" required minlength="10" maxlength="5000" rows="6" aria-invalid={errors.message?'true':undefined}>{value('message')}</textarea>{errors.message&&<p class="field-error">{errors.message}</p>}
<div class="honeypot" aria-hidden="true"><label for="company-url">Leave this blank</label><input id="company-url" name="company_url" tabindex="-1" autocomplete="off"/></div>
<label class="check"><input id="field-acknowledgment" type="checkbox" name="acknowledgment" value="yes" required checked={value('acknowledgment')==='yes'}/><span>I have read the <a href="/privacy-policy/">privacy information</a> and want a reply to this inquiry. *</span></label>
<button class="button" type="submit">{service==='guest'?'Submit guest inquiry':'Send inquiry'} <span aria-hidden="true">↗</span></button><p class="form-note">If online delivery is unavailable, email <a href={`mailto:${site.email}`}>{site.email}</a>.</p></form>
<script>
document.querySelectorAll<HTMLFormElement>('.inquiry-form').forEach(form=>{form.addEventListener('submit',()=>{const button=form.querySelector<HTMLButtonElement>('button[type=submit]');if(button){button.disabled=true;button.textContent='Sending…';form.setAttribute('aria-busy','true');}});});
window.addEventListener('pageshow',()=>document.querySelectorAll<HTMLButtonElement>('.inquiry-form button[type=submit]').forEach(button=>{button.disabled=false;button.textContent=button.closest('form')?.querySelector<HTMLInputElement>('input[name=service]')?.value==='guest'?'Submit guest inquiry ↗':'Send inquiry ↗';button.closest('form')?.removeAttribute('aria-busy');}));
</script>
