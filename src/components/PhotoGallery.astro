---
import {Image} from 'astro:assets';
import speaking from '../assets/loren-speaking.jpg';import coaching from '../assets/workshop.jpg';import writing from '../assets/interview.jpg';import program from '../assets/loren-blue.jpg';import story from '../assets/loren-floral.jpg';import show from '../assets/loren-hat.jpg';
const cards=[{label:'Keynote Speaking',title:'Give the room something to carry.',href:'/services/speaking/',image:speaking},{label:'Coaching',title:'Find the voice that sounds like you.',href:'/services/coaching/',image:coaching},{label:'Keynote Writing',title:'Your ideas. A message that lands.',href:'/services/keynote-writing/',image:writing},{label:'The Mindset Revolution',title:'Make room for your next move.',href:'/the-mindset-revolution/',image:program},{label:'Meet Loren',title:'Before the stage, there was a story.',href:'/about/',image:story},{label:'Bathrobe Moments',title:'Come as you are. Bring your story.',href:'/bathrobe-moments/',image:show}];
---
<section class="section photo-gallery" data-carousel="auto" aria-labelledby="gallery-title"><div class="wrap section-heading"><div><p class="eyebrow">DIFFERENT ROOMS. ONE HUMAN CONNECTION.</p><h2 id="gallery-title">Find your way<br/><em>into the conversation.</em></h2></div><button data-carousel-pause class="gallery-pause text-button" type="button" hidden aria-pressed="false">Pause gallery</button></div>{[cards.slice(0,3),cards.slice(3)].map((row,i)=><div class:list={['photo-row',{'reverse':i===1}]} data-carousel-row data-direction={i===1?'reverse':'forward'} tabindex="0" aria-label={i===0?'Speaking, coaching and writing':'Programs, Loren’s story and the show'}><div class="photo-track">{row.map(card=><a class="photo-card" data-carousel-card href={card.href}><Image src={card.image} alt="" widths={[400,700]} sizes="(max-width:767px) 85vw, 34vw" loading="lazy"/><div><p class="eyebrow">{card.label}</p><h3>{card.title}</h3><span>Explore <span aria-hidden="true">↗</span></span></div></a>)}</div></div>)}</section>
<script>
import {setupCarousels} from '../scripts/carousels';
setupCarousels();
</script>
