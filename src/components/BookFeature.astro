---
import {site} from '../data/site';
---
<section class="book-launch" id="the-book" aria-labelledby="book-title"><div class="wrap book-launch-grid"><div class="book-art"><img src="/media/book-showcase.webp" alt="From Splintered to Centered: 7 Dimensions for Navigating Your Soul, by Dr. Sanjiv Chopra and Dr. Loren Michaels Harris" width="1916" height="821" loading="lazy"/></div><div class="book-launch-copy"><p class="eyebrow">THE BOOK · FROM SPLINTERED TO CENTERED</p><h2 id="book-title">You haven’t lost yourself.<br/><em>You’re finding your way back.</em></h2><p>You can build a career, fill a calendar, and be surrounded by people—and still feel far from yourself.</p><p><strong>From Splintered to Centered</strong> invites you to rediscover the relationship beneath it all: the relationship with your soul.</p><p class="metadata">By Dr. Sanjiv Chopra & Dr. Loren Michaels Harris</p><a class="button" href={site.book} target="_blank" rel="noopener noreferrer" aria-label="Discover the Book (opens in a new tab)">Discover the Book <span aria-hidden="true">↗</span></a></div></div></section>
<dialog class="book-dialog" aria-labelledby="book-dialog-title"><div class="book-dialog-header"><button class="dialog-close" type="button" aria-label="Close book invitation">×</button></div><div class="book-dialog-content"><div class="book-dialog-grid"><div class="book-art"><img src="/media/book-showcase.webp" alt="From Splintered to Centered book" width="1916" height="821" loading="lazy"/></div><div><p class="eyebrow">A RETURN TO YOURSELF</p><h2 id="book-dialog-title">From Splintered<br/>to <em>Centered.</em></h2><p>Seven dimensions for navigating your soul. Discover the book by Dr. Sanjiv Chopra and Dr. Loren Michaels Harris.</p><a class="button" href={site.book} target="_blank" rel="noopener noreferrer" aria-label="Discover the Book (opens in a new tab)">Discover the Book ↗</a><button class="text-button book-later" type="button">Keep exploring Loren’s site</button></div></div></div></dialog>
<script>
const dialog=document.querySelector<HTMLDialogElement>('.book-dialog');const feature=document.querySelector('#the-book');
if(dialog&&feature){let previous:HTMLElement|null=null;let dismissed=false;let elapsed=false;
try{dismissed=sessionStorage.getItem('lmh-book-seen')==='yes';}catch{}
const close=()=>dialog.close();dialog.querySelector('.dialog-close')?.addEventListener('click',close);dialog.querySelector('.book-later')?.addEventListener('click',close);
dialog.addEventListener('click',e=>{if(e.target===dialog){const r=dialog.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)close();}});
dialog.addEventListener('close',()=>previous?.focus({preventScroll:true}));
dialog.addEventListener('keydown',event=>{if(event.key!=='Tab')return;const controls=[...dialog.querySelectorAll<HTMLElement>('a[href],button:not([disabled]),[tabindex="0"]')].filter(el=>el.getClientRects().length>0);const first=controls[0],last=controls.at(-1);if(event.shiftKey&&document.activeElement===first){event.preventDefault();last?.focus();}else if(!event.shiftKey&&document.activeElement===last){event.preventDefault();first?.focus();}});
const attempt=()=>{if(dismissed||!elapsed||feature.getBoundingClientRect().bottom>=0||document.hidden||document.querySelector('cinema-player[data-playing="true"], .preview-playing, .watch-dialog[open]')||document.activeElement?.closest('form,nav,details,dialog'))return;dismissed=true;try{sessionStorage.setItem('lmh-book-seen','yes');}catch{}previous=document.activeElement as HTMLElement;dialog.showModal();};
setTimeout(()=>{elapsed=true;attempt();},30000);window.addEventListener('scroll',attempt,{passive:true});document.addEventListener('lmh-media-state',attempt);document.addEventListener('focusout',()=>setTimeout(attempt,0));
}
</script>
