---
import {getCollection} from 'astro:content';
import {visibleEvidence} from '../lib/content-visibility';
interface Props {compact?:boolean;}
const {compact=false}=Astro.props;
const entries=await getCollection('testimonials',e=>visibleEvidence(e.data,import.meta.env.SITE_ENV==='production'));
const selected=compact?entries.slice(0,3):entries;
---
{selected.length>0&&<section class="section evidence-section"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">THE PEOPLE IN THE ROOM</p><h2>The message stays.<br/><span class="gold-text">Long after the moment.</span></h2></div><a class="text-link" href="/testimonials/">Read their experiences ↗</a></div><div class:list={['quotes',{'quotes-full':!compact}]}>{selected.map(({id,data:d})=><figure class="quote-card" id={id}><span class="quote-mark" aria-hidden="true">“</span><blockquote><p>{compact&&d.excerpt?d.excerpt:d.quote}</p></blockquote><figcaption><strong>{d.person}</strong><span>{d.role}</span></figcaption>{compact&&<a class="quote-source" href={`/testimonials/#${id}`}>Read full testimonial ↗</a>}{!compact&&<a class="quote-source" href={d.sourceUrl}>Originally published on Loren’s website ↗</a>}</figure>)}</div></div></section>}
