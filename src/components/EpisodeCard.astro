---
import type {Episode} from '../lib/dashboard/store';import {showDate,broadcastStart} from '../lib/dashboard/time';
interface Props {episode:Episode;}
const {episode:e}=Astro.props;
---
<article class="episode-card"><a class="episode-art" href={`/bathrobe-moments/episodes/${e.slug}/`}><img src={e.banner} alt={`${e.guest} · Bathrobe Moments show banner`} width="1280" height="720" loading="lazy"/></a><div class="episode-card-copy"><p class="eyebrow">{e.cancelled?'CANCELED':e.date?showDate(broadcastStart(e.date)):'FROM THE SHOW ARCHIVE'}</p><h3><a href={`/bathrobe-moments/episodes/${e.slug}/`}>{e.title}</a></h3><p>{e.description}</p><a class="text-link" href={`/bathrobe-moments/episodes/${e.slug}/`}>{e.replayUrl?'Watch the conversation':'Episode details'} ↗</a></div></article>
