---
import {episodeVisibility,publicationMissing} from '../lib/dashboard/presentation';
import type {Episode} from '../lib/dashboard/store';
interface Props {list:Episode[];editor:Episode;editing:boolean;persisted:boolean;csrfToken:string;error:string;url:URL;}
const {list,editor,editing,persisted,csrfToken,error,url}=Astro.props;
const status=url.searchParams.get('status')||'all',q=(url.searchParams.get('q')||'').slice(0,100);
const filtered=list.filter(e=>(status==='trash'?!!e.trashedAt:!e.trashedAt&&(status==='drafts'?!e.published:status==='published'?e.published:true))&&(!q||(e.guest+' '+e.title).toLowerCase().includes(q.toLowerCase()))).sort((a,b)=>b.date.localeCompare(a.date));
const confirmation=list.find(e=>e.id===url.searchParams.get('trash'));
const visibility=episodeVisibility(editor);const missing:Record<string,string>=error?publicationMissing(editor):{} as Record<string,string>;
---
{confirmation&&!confirmation.trashedAt?<section class="admin-card admin-trash-confirm" aria-labelledby="trash-heading"><h2 id="trash-heading">Move “{confirmation.title}” to Trash?</h2><p>This episode will disappear from public pages. Its URL, banner and content will be retained so you can restore it as a draft.</p><p><strong>This does not cancel any Calendly reservation.</strong></p><form method="post"><input type="hidden" name="csrf" value={csrfToken}/><input type="hidden" name="action" value="trash-episode"/><input type="hidden" name="id" value={confirmation.id}/><div class="admin-actions"><button class="admin-button danger">Confirm move to Trash</button><a href="/admin/?tab=episodes">Keep episode</a></div></form></section>:editing?<>
<section class="admin-alert episode-visibility"><strong>{visibility.text}</strong>{persisted&&visibility.href&&<p><a href={visibility.href} target="_blank" rel="noopener noreferrer">{editor.published?'View public placement ↗':'Preview privately ↗'}</a></p>}<p>Manual episodes do not need an application or Calendly booking. Only published episodes dated within the selected week appear in that week’s lineup.</p></section>
{editor.trashedAt?<section class="admin-card"><h2>{editor.title}</h2><p>This episode is in Trash. Restore it as a draft to edit it.</p><form method="post"><input type="hidden" name="csrf" value={csrfToken}/><input type="hidden" name="action" value="restore-episode"/><input type="hidden" name="id" value={editor.id}/><button class="admin-button primary">Restore as draft</button></form></section>:<form method="post" enctype="multipart/form-data" class="admin-card"><input type="hidden" name="csrf" value={csrfToken}/><input type="hidden" name="action" value="save-episode"/><input type="hidden" name="id" value={editor.id}/><h2>{persisted?'Edit episode':'Add an episode'}</h2><p>Save privately while preparing the details, or publish when everything is ready.</p><div class="admin-grid">{(['guest','title','slug','date'] as const).map(key=><div><label for={key}>{({guest:'Guest name *',title:'Episode title / topic *',slug:'Permanent URL slug *',date:'Broadcast date'})[key]}</label><input id={key} name={key} type={key==='date'?'date':'text'} value={editor[key]} required={key!=='date'} readonly={key==='slug'&&persisted} maxlength={key==='slug'?120:200} aria-invalid={missing[key]?'true':undefined} aria-describedby={missing[key]?key+'-error':undefined}/>{missing[key]&&<p id={key+'-error'} class="field-error">{missing[key]}</p>}{key==='slug'&&<p class="admin-note">This URL stays the same after rescheduling.</p>}{key==='date'&&<p class="admin-note">Monday–Friday at 10 AM America/Chicago.</p>}</div>)}</div>
<label for="banner">Finished show banner</label>{editor.banner&&<img class="admin-banner" src={editor.banner} alt="Current guest-show banner"/>}<input id="banner" name="banner" type="file" accept="image/jpeg,image/png,image/webp" aria-describedby="banner-note"/><p id="banner-note" class="admin-note">JPEG, PNG or WebP, maximum 2 MB. Full proportions are preserved. Public only after publication.</p>{missing.banner&&<p class="field-error">{missing.banner}</p>}
{(['biography','description','highlights','transcript'] as const).map(key=><><label for={key}>{({biography:'Guest biography',description:'Episode description',highlights:'Highlights (optional)',transcript:'Transcript (optional)'})[key]}</label><textarea id={key} name={key} rows={key==='transcript'?8:4} maxlength={key==='transcript'?50000:key==='highlights'?10000:5000} aria-invalid={missing[key]?'true':undefined} aria-describedby={missing[key]?key+'-error':undefined}>{editor[key]}</textarea>{missing[key]&&<p id={key+'-error'} class="field-error">{missing[key]}</p>}</>)}
<div class="admin-grid"><div><label for="liveUrl">Public live-broadcast link</label><input id="liveUrl" name="liveUrl" type="url" value={editor.liveUrl}/></div><div><label for="replayUrl">Verified replay link</label><input id="replayUrl" name="replayUrl" type="url" value={editor.replayUrl}/></div></div><label for="recordingPublishedAt">Recording publication date (verified, optional)</label><input id="recordingPublishedAt" name="recordingPublishedAt" type="date" value={editor.recordingPublishedAt}/><label><input type="checkbox" name="cancelled" value="yes" checked={editor.cancelled}/>Mark episode cancelled (does not cancel Calendly reservations)</label><div class="admin-actions"><button class="admin-button" name="intent" value="draft">Save draft</button><button class="admin-button primary" name="intent" value="publish">Publish episode</button>{persisted&&<a class="admin-button" href={`/bathrobe-moments/episodes/${editor.slug}/?preview=1`} target="_blank" rel="noopener noreferrer">Preview episode ↗</a>}<a href="/admin/?tab=episodes">Back to episodes</a>{persisted&&<a class="admin-button danger" href={`/admin/?tab=episodes&trash=${editor.id}`}>Move to Trash</a>}</div></form>}</>:<>
<div class="admin-actions"><a class="admin-button primary" href="/admin/?tab=episodes&new=1">Add an episode +</a><p>Manage episodes directly. Guest applications and calendar bookings are separate.</p></div><nav class="admin-nav" aria-label="Episode status">{[['all','All'],['drafts','Drafts'],['published','Published'],['trash','Trash']].map(([value,label])=><a href={`?tab=episodes&status=${value}&q=${encodeURIComponent(q)}`} aria-current={status===value?'page':undefined}>{label} ({list.filter(e=>value==='trash'?!!e.trashedAt:!e.trashedAt&&(value==='drafts'?!e.published:value==='published'?e.published:true)).length})</a>)}</nav><form method="get" class="admin-search"><input type="hidden" name="tab" value="episodes"/><input type="hidden" name="status" value={status}/><label for="episode-search">Find a guest or topic</label><div class="admin-actions"><input id="episode-search" name="q" type="search" value={q} maxlength="100"/><button class="admin-button">Search episodes</button></div></form>
<div class="admin-grid episode-admin-list">{filtered.map(e=><article class="admin-card">{e.banner&&<img class="admin-banner" src={e.banner} alt={`${e.guest} episode banner`} loading="lazy"/>}<p class="admin-status">{e.trashedAt?'In Trash':e.cancelled?'Cancelled':e.published?'Published':'Draft'} · {e.date||'No broadcast date'}</p><h2>{e.title}</h2><p>{e.guest}</p><p class="admin-note">{episodeVisibility(e).text}</p><div class="admin-actions">{e.trashedAt?<form method="post"><input type="hidden" name="csrf" value={csrfToken}/><input type="hidden" name="action" value="restore-episode"/><input type="hidden" name="id" value={e.id}/><button class="admin-button">Restore as draft</button></form>:<><a href={`/admin/?tab=episodes&edit=${e.id}`}>Edit episode →</a><a class="admin-button danger" href={`/admin/?tab=episodes&trash=${e.id}`}>Move to Trash</a></>}</div></article>)}</div>{!filtered.length&&<p class="admin-alert">No episodes match this view.</p>}</>}
