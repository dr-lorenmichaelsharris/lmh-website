---
import CinemaPlayer from './CinemaPlayer.astro';
import {visibleEvidence} from '../lib/content-visibility';
import records from '../data/video-testimonials.json';
interface Props { heading?: string; description?: string; }
const {
  heading = 'Working with Loren. In their own words.',
  description = 'Robert A. Lane, Martha Glory, and Amy Joy share their experiences of working with Loren. These accounts describe their individual engagements; they are not presented as graduates of The Mindset Revolution.',
} = Astro.props;
const selected = records.filter(record=>visibleEvidence(record, import.meta.env.SITE_ENV === 'production'));
---
{selected.length > 0 && <section class="section video-evidence" aria-label="Experiences working with Loren">
  <div class="wrap">
    <div class="video-evidence-intro"><p class="eyebrow">EXPERIENCES WORKING WITH LOREN</p><h2>{heading}</h2><p>{description}</p></div>
    <div class="video-evidence-grid">{selected.map(record=><article>
      <h3>{record.name}</h3>
      <CinemaPlayer videoId={record.videoId} title={record.name + ' on working with Loren'} poster={record.poster}/>
    </article>)}</div>
    <p class="metadata">Preview selection · Publication review pending. <a href={selected[0].sourceUrl}>Published testimonial collection ↗</a></p>
  </div>
</section>}
<style>
  .video-evidence { background:#171815; }
  .video-evidence-intro { max-width:900px; margin-bottom:44px; }
  .video-evidence-intro p:not(.eyebrow) { max-width:780px; color:var(--muted); }
  .video-evidence-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:28px; }
  .video-evidence-grid article { min-width:0; }
  .video-evidence-grid h3 { border-top:1px solid #8c7741; padding-top:24px; margin-bottom:24px; }
  .video-evidence .metadata { margin-top:32px; }
  @media(max-width:1099px) { .video-evidence-grid { grid-template-columns:1fr; gap:44px; } .video-evidence-grid article { max-width:850px; } }
</style>
