---
import '../styles/global.css';
import '../styles/cinematic.css';
import '../styles/launch.css';
import {Image} from 'astro:assets';
import brandLogo from '../assets/lmh-brand-transparent.png';
import PhotoMotion from '../components/PhotoMotion.astro';
import HeaderMenu from '../components/HeaderMenu.astro';

import { site } from '../data/site';
interface Props {title:string; description?:string; noindex?:boolean; image?:string; reading?:boolean;}
const { title, description='Speaking, coaching and keynote writing with Loren Michaels Harris. Explore stories, perspective and the possibilities ahead.', noindex=false,image='/social.webp',reading=false }=Astro.props;
const staging=import.meta.env.SITE_ENV!=='production';
const path=Astro.url.pathname;
const nav=[['Keynote Speaking','/services/speaking/'],['About','/about/'],['Bathrobe Moments','/bathrobe-moments/'],];
const resources=[['Blog','/blog/'],['Media Kit','/media-kit/'],['FAQs','/faqs/'],['Testimonials','/testimonials/']];
const work=[['Coaching','/services/coaching/'],['Keynote Writing','/services/keynote-writing/'],['The Mindset Revolution','/the-mindset-revolution/'],['Contact','/contact/'],['Testimonials','/testimonials/']];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title} | Loren Michaels Harris</title><meta name="description" content={description}/><link rel="canonical" href={new URL(path,site.origin)}/><meta name="robots" content={staging||noindex?'noindex, nofollow':'index, follow'}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={new URL(path,site.origin)}/><meta property="og:image" content={new URL(image,site.origin)}/><meta name="twitter:card" content="summary_large_image"/><link rel="preload" href="/fonts/barlow-condensed-700.woff2" as="font" type="font/woff2" crossorigin/><link rel="preload" href="/fonts/manrope-variable.woff2" as="font" type="font/woff2" crossorigin/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/></head>
<body class:list={{'reading-theme':reading}}><a class="skip" href="#content">Skip to content</a>
<header class="site-header"><a class="wordmark" href="/" aria-label="Loren Michaels Harris home"><Image class="brand-logo" src={brandLogo} width={88} height={88} widths={[88,176,264]} sizes="(max-width:767px) 64px, 88px" format="webp" alt="" loading="eager"/><span class="brand-wording">LOREN MICHAELS HARRIS<small>Speaker & coach</small></span></a>
<nav class="desktop-nav" aria-label="Main navigation"><a href="/services/speaking/" aria-current={path==='/services/speaking/'?'page':undefined}>Keynote Speaking</a><HeaderMenu id="work-menu-panel" label="Work with Loren" href="/services/" items={work} descriptions={['Find clarity and develop your voice.','Give your keynote structure and direction.','12 weeks of classes and private coaching.','Tell Loren what you have in mind.','Hear from people who have worked with Loren.']} eyebrow="FIND THE RIGHT SUPPORT"/>{nav.slice(1).map(([label,href])=><a href={href} aria-current={path===href?'page':undefined}>{label}</a>)}<HeaderMenu id="resources-menu-panel" label="Resources" href="/resources/" items={resources} eyebrow="READ, WATCH & EXPLORE"/></nav>
<a class="header-cta" href={site.calendly}>Schedule a Call <span aria-hidden="true">↗</span></a><details class="mobile-nav"><summary>Menu</summary><nav aria-label="Mobile navigation"><a href={site.calendly}>Schedule a Call ↗</a><a href="/services/speaking/">Keynote Speaking</a><span class="eyebrow">WORK WITH LOREN</span><a href="/services/">All services</a>{work.map(([label,href])=><a href={href} aria-current={path===href?'page':undefined}>{label}</a>)}<span class="eyebrow">EXPLORE</span>{nav.slice(1).map(([label,href])=><a href={href} aria-current={path===href?'page':undefined}>{label}</a>)}<span class="eyebrow">RESOURCES</span><a href="/resources/">All resources</a>{resources.map(([label,href])=><a href={href} aria-current={path===href?'page':undefined}>{label}</a>)}</nav></details></header>
<main id="content"><slot/></main>
<footer class="site-footer"><div class="footer-top"><div><p class="eyebrow">YOUR NEXT EVENT. YOUR NEXT MESSAGE.</p><h2>Make room for<br/><em>something real.</em></h2><a class="button gold" href="/contact/">Discuss your project <span aria-hidden="true">↗</span></a><a class="footer-booking" href={site.calendly}>Schedule a Call ↗</a></div><div><h3>Explore</h3><a href="/services/">Work with Loren</a><a href="/services/keynote-writing/">Keynote Writing</a><a href="/the-mindset-revolution/">The Mindset Revolution</a><a href="/blog/">Blog</a><a href="/media-kit/">Media Kit</a><a href="/faqs/">FAQs</a><a href="/testimonials/">Testimonials</a></div><div><h3>Stay connected</h3><p>Notes on storytelling, leadership,<br/>and life beyond the stage.</p><form action="/api/submit/" method="post"><input type="hidden" name="service" value="newsletter"/><label for="newsletter-email">Email address</label><input id="newsletter-email" name="email" type="email" required maxlength="254" autocomplete="email"/><label class="check"><input type="checkbox" name="consent" required value="yes"/>I’d like email updates.</label><button class="text-button" type="submit">Subscribe →</button></form><a href={`mailto:${site.email}`}>{site.email}</a></div></div><div class="footer-bottom"><small>© {new Date().getUTCFullYear()} Loren Michaels Harris</small><a href="/important-links/">Policies & Accessibility</a><a href="/privacy-policy/">Privacy</a><a href={site.youtube}>YouTube ↗</a><a href={site.book} target="_blank" rel="noopener noreferrer" aria-label="From Splintered to Centered (opens in a new tab)">From Splintered to Centered ↗</a></div></footer><PhotoMotion/></body></html>



<script>
document.querySelectorAll<HTMLDetailsElement>('.mobile-nav').forEach(menu=>{menu.addEventListener('keydown',event=>{if(event.key==='Escape'){menu.open=false;menu.querySelector('summary')?.focus();}});document.addEventListener('click',event=>{if(!menu.contains(event.target as Node))menu.open=false;});});
document.querySelectorAll<HTMLElement>('[data-navigation-menu]').forEach(menu=>{
const toggle=menu.querySelector<HTMLButtonElement>('button')!,panel=menu.querySelector<HTMLElement>('.work-menu-panel')!,label=menu.dataset.menuLabel!;toggle.hidden=false;
const setOpen=(open:boolean)=>{toggle.setAttribute('aria-expanded',String(open));toggle.setAttribute('aria-label',(open?'Close ':'Show ')+label+' menu');panel.hidden=!open;};
toggle.addEventListener('click',()=>{const open=!!panel.hidden;document.querySelectorAll<HTMLButtonElement>('[data-navigation-menu] button[aria-expanded="true"]').forEach(other=>{if(other!==toggle)other.click();});setOpen(open);});
menu.addEventListener('keydown',e=>{if(e.key==='Escape'){setOpen(false);toggle.focus();}if(e.key==='ArrowDown'&&e.target===toggle){e.preventDefault();setOpen(true);panel.querySelector<HTMLAnchorElement>('a')?.focus();}});
document.addEventListener('click',e=>{if(!menu.contains(e.target as Node))setOpen(false);});menu.addEventListener('focusout',()=>setTimeout(()=>{if(!menu.contains(document.activeElement))setOpen(false);},0));
});
</script>
