---
import '../styles/global.css';
import '../styles/cinematic.css';
import PhotoMotion from '../components/PhotoMotion.astro';

import { site } from '../data/site';
interface Props {title:string; description?:string; noindex?:boolean; image?:string; reading?:boolean;}
const { title, description='Speaking, coaching and keynote writing with Loren Michaels Harris. Explore stories, perspective and the possibilities ahead.', noindex=false,image='/social.webp',reading=false }=Astro.props;
const staging=import.meta.env.SITE_ENV!=='production';
const path=Astro.url.pathname;
const nav=[['Speaking','/services/speaking/'],['Coaching & Programs','/services/coaching/'],['About','/about/'],['Resources','/resources/'],['Bathrobe Moments','/bathrobe-moments/']];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title} | Loren Michaels Harris</title><meta name="description" content={description}/><link rel="canonical" href={new URL(path,site.origin)}/><meta name="robots" content={staging||noindex?'noindex, nofollow':'index, follow'}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={new URL(path,site.origin)}/><meta property="og:image" content={new URL(image,site.origin)}/><meta name="twitter:card" content="summary_large_image"/><link rel="preload" href="/fonts/barlow-condensed-700.woff2" as="font" type="font/woff2" crossorigin/><link rel="preload" href="/fonts/manrope-variable.woff2" as="font" type="font/woff2" crossorigin/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/></head>
<body class:list={{'reading-theme':reading}}>{staging&&<div class="preview-label">LOCAL PREVIEW · EXISTING TESTIMONIALS INCLUDED FOR REVIEW</div>}<a class="skip" href="#content">Skip to content</a><header class="site-header"><a class="wordmark" href="/" aria-label="Loren Michaels Harris home"><img class="brand-logo" src="/lmh-brand.webp" width="58" height="58" alt=""/><span class="brand-wording">LOREN MICHAELS HARRIS<small>SPEAKER · COACH · STORYTELLER</small></span></a><nav class="desktop-nav" aria-label="Main navigation">{nav.map(([label,href])=><a href={href} aria-current={path===href?'page':undefined}>{label}</a>)}</nav><a class="header-cta" href="/contact/?service=speaking">Event inquiries <span aria-hidden="true">↗</span></a><details class="mobile-nav"><summary>Menu</summary><nav aria-label="Mobile navigation">{nav.map(([label,href])=><a href={href}>{label}</a>)}<a href="/services/keynote-writing/">Keynote Writing</a><a href="/the-mindset-revolution/">The Mindset Revolution</a><a href="/contact/">Contact</a></nav></details></header>
<main id="content"><slot/></main>
<footer class="site-footer"><div class="footer-top"><div><p class="eyebrow">YOUR NEXT EVENT. YOUR NEXT MESSAGE.</p><h2>Make room for<br/><em>something real.</em></h2><a class="button gold" href="/contact/">Discuss your project <span aria-hidden="true">↗</span></a></div><div><h3>Explore</h3><a href="/services/">Work with Loren</a><a href="/services/keynote-writing/">Keynote Writing</a><a href="/the-mindset-revolution/">The Mindset Revolution</a><a href="/blog/">The Journal</a><a href="/media-kit/">Media Kit</a><a href="/faqs/">FAQs</a><a href="/results/">Audience experiences</a></div><div><h3>Stay connected</h3><p>Notes on storytelling, leadership,<br/>and life beyond the stage.</p><form action="/api/submit/" method="post"><input type="hidden" name="service" value="newsletter"/><label for="newsletter-email">Email address</label><input id="newsletter-email" name="email" type="email" required maxlength="254" autocomplete="email"/><label class="check"><input type="checkbox" name="consent" required value="yes"/>I’d like email updates.</label><button class="text-button" type="submit">Subscribe →</button></form><a href={`mailto:${site.email}`}>{site.email}</a></div></div><div class="footer-bottom"><small>© {new Date().getUTCFullYear()} Loren Michaels Harris</small><a href="/important-links/">Policies & Accessibility</a><a href="/privacy-policy/">Privacy</a><a href={site.youtube}>YouTube ↗</a><a href={site.book}>From Splintered to Centered ↗</a></div></footer><PhotoMotion/></body></html>


