---
export const prerender=false;
import Base from '../layouts/Base.astro';
import {site} from '../data/site';
import {readReceipt} from '../lib/forms';
Astro.response.headers.set('Cache-Control','no-store');
const receipt=readReceipt(Astro.cookies.get('lmh-receipt')?.value,process.env.RECEIPT_SECRET??import.meta.env.RECEIPT_SECRET??process.env.FORM_WEBHOOK_TOKEN??import.meta.env.FORM_WEBHOOK_TOKEN);
---
<Base title="Inquiry status" noindex><section class="status-panel"><p class="eyebrow">INQUIRY STATUS</p><h1>{receipt?(receipt.local?'Local test received.':'Your inquiry was accepted.'):'No submission to confirm.'}</h1><p>{receipt?(receipt.local?'This was a local simulation. No email was sent and no subscription, booking or payment was created.':'The delivery service accepted your inquiry. This does not confirm a booking, payment or appearance.'):'A visit to this page does not confirm an application, payment or scheduled appearance.'}</p>{receipt?.package&&<p>Package preference: {receipt.package}. This is not an order.</p>}{receipt&&receipt.service!=='newsletter'&&<div class="confirmation-booking"><h2>{receipt.service==='guest'?'Next: your pre-show discovery call.':'Let’s keep the conversation going.'}</h2><p>{receipt.service==='guest'?'Use Loren’s calendar to schedule a discovery call before the show. We’ll discuss your story, fit, and next steps.':'If you would like to talk through your inquiry, explore available appointments on Loren’s calendar.'}</p>{!receipt.local&&<a class="button" href={site.calendly}>{receipt.service==='guest'?'Schedule your pre-show discovery call':'Schedule a Call'} ↗</a>}</div>}<div class="actions"><a class="button" href="/contact/">Start an inquiry ↗</a><a href="/">Back to home</a></div></section></Base>
