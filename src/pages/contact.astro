---
export const prerender=false;
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import InquiryForm from '../components/InquiryForm.astro';
import {site,serviceIntents} from '../data/site';
const requested=Astro.url.searchParams.get('service')||'general';
const service=serviceIntents.includes(requested as typeof serviceIntents[number])&&!['guest','newsletter'].includes(requested)?requested:'general';
---
<Base title="Start a conversation"><PageIntro title="Tell us what you’re planning." eyebrow="CONTACT" description="Share your event, coaching goal, or writing project. Choose an inquiry type below to get started."/><section class="section wrap inquiry-layout"><aside class="inquiry-sidebar"><h2>Start here.</h2><nav aria-label="Inquiry type"><ul><li><a href="?service=speaking">Event & speaking</a></li><li><a href="?service=coaching">Coaching</a></li><li><a href="?service=keynote-writing">Keynote Writing</a></li><li><a href="?service=program">The Mindset Revolution</a></li><li><a href="/bathrobe-moments/apply/">Bathrobe Moments guest</a></li><li><a href="?service=general">General & media</a></li></ul></nav><p>Prefer email?<br/><a href={`mailto:${site.email}`}>{site.email}</a></p></aside><div><p class="eyebrow">{service==='general'?'GENERAL & MEDIA':service.replaceAll('-',' ')}</p><InquiryForm service={service}/></div></section></Base>
