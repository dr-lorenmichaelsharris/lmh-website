---
export const prerender=false;
import Base from '../../layouts/Base.astro';import GuestBooking from '../../components/GuestBooking.astro';import {verifyResume} from '../../lib/dashboard/auth';import {application} from '../../lib/dashboard/store';
Astro.response.headers.set('Cache-Control','no-store');Astro.response.headers.set('Referrer-Policy','strict-origin');const token=Astro.url.searchParams.get('token')||'';let guest;try{const id=verifyResume(token);guest=id?await application(id):undefined;}catch{}if(guest?.closed)guest=undefined;if(guest?.delivery!=='accepted')Astro.response.status=403;
---
<Base title="Your guest application and booking" noindex><section class="section wrap"><p class="eyebrow">BATHROBE MOMENTS · PRIVATE GUEST JOURNEY</p><h1>{guest?'Your next steps.':'This private link is unavailable.'}</h1>{guest?<GuestBooking showRescheduleUrl={guest.show?.rescheduleUrl} discoveryRescheduleUrl={guest.discovery?.rescheduleUrl} token={token} name={guest.name} email={guest.email} showStart={guest.show?.status==='active'?guest.show.start:''} discoveryStart={guest.discovery?.status==='active'?guest.discovery.start:''}/>:<p>Use the link from your application confirmation, or contact <a href="mailto:hello@lorenmichaelsharris.com">hello@lorenmichaelsharris.com</a>. No booking has been changed.</p>}</section></Base>
