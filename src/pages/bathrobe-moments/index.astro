---
export const prerender=false;
import Base from '../../layouts/Base.astro';import {Image} from 'astro:assets';import {getCollection} from 'astro:content';import portrait from '../../assets/loren-hat.jpg';import InquiryForm from '../../components/InquiryForm.astro';import GuestOffer from '../../components/GuestOffer.astro';import VideoGallery from '../../components/VideoGallery.astro';import {site} from '../../data/site';
Astro.response.headers.set('Cache-Control','no-store');
const episodes=await getCollection('episodes',({data})=>data.publish&&data.approvalStatus==='approved');
const clips=['geoff','mavis','lee','brett','grace','alice'].map(id=>episodes.find(e=>e.id===id)).filter(e=>e!==undefined).map(e=>({title:e.data.title,source:'BATHROBE MOMENTS · FULL CONVERSATION',poster:`/media/episode-${e.id}.jpg`,videoId:new URL(e.data.watchUrl).searchParams.get('v')||''}));
const pillars=[['Real stories','The experiences behind the introduction. The moments that shaped how you live, lead, and connect.'],['Raw truths','Honest conversations with room for the complicated parts. You don’t need a perfect answer.'],['Resilient souls','What challenge, loss, and rebuilding have taught us—and what we are still learning.'],['Relentless growth','A little reflection. A little courage. Another way to see what comes next.']];
const profiles=[['The Phoenix','You have rebuilt after loss, failure, grief, or a setback—and have a story about what helped you begin again.'],['The Truth Teller','You bring honesty, courage, and clarity to a conversation people may find difficult to start.'],['The Healer','Your work or lived experience touches forgiveness, grief, recovery, emotional restoration, or spiritual growth.'],['The Builder','You are an entrepreneur, leader, creator, or visionary building something meaningful.'],['The Hidden Gem','You may not be widely known. Your experience and perspective still deserve to be heard.'],['The Legacy Builder','You serve through mentorship, community, or work that reaches beyond yourself.']];
---
<Base title="Bathrobe Moments with Loren Michaels Harris" description="Real stories. Raw truths. Resilient souls. Watch Bathrobe Moments, meet the show, and apply to share your story with Loren.">
<section class="show-cinema-hero"><div class="show-cinema-copy"><p class="eyebrow">THE RETURN OF BATHROBE MOMENTS</p><h1>Real stories.<br/><em>Resilient souls.</em></h1><p>Real stories. Raw truths. Resilient souls. Hosted by Dr. Loren Michaels Harris, this is a space to show up as you are and speak from the heart.</p><div class="actions"><a class="button" href="#application">Apply to be a guest ↓</a><a class="text-link" href="#watch">Watch the conversations ↓</a></div></div><div class="show-brand-film"><img src="/media/bathrobe-hero.webp" alt="Bathrobe Moments show branding" width="1280" height="720" fetchpriority="high"/><video data-ambient-film data-src="/media/bathrobe-hero.mp4" poster="/media/bathrobe-hero.webp" muted loop playsinline preload="none" aria-label="Bathrobe Moments animated introduction" hidden></video><button class="ambient-toggle" type="button" hidden>Play introduction</button><noscript><a class="ambient-toggle" href="/media/bathrobe-hero.mp4">Watch introduction ↗</a></noscript></div></section>
<nav class="wrap section-jumps" aria-label="On this page"><a href="#show-story">About the show</a><a href="#watch">Watch conversations</a><a href="#guest-invitation">Become a guest</a><a href="#application">Apply now</a></nav><section class="section light-section show-history" id="show-story"><div class="wrap split"><div><p class="eyebrow">THE CONVERSATION CONTINUES</p><h2>A familiar chair.<br/><em>A new season.</em></h2></div><div><p>Bathrobe Moments began as a morning broadcast and grew into a place for vulnerability, purpose, and human connection.</p><p>After more than a decade of conversations, Loren returns with the same invitation: go beyond the polished introduction and talk about what makes us human.</p><p>This return carries that history forward, with room for new voices and stories still unfolding.</p></div></div></section>
<section class="section wrap"><div class="split"><figure><Image class="host-photo" src={portrait} alt="Your host, Loren Michaels Harris, smiling in a pink shirt and hat" widths={[400,700,1000]} sizes="(max-width:767px) 100vw, 45vw" loading="lazy"/></figure><div><p class="eyebrow">FROM YOUR HOST</p><h2>Presence.<br/><em>Before performance.</em></h2><blockquote class="host-message">“Bathrobe Moments has always been about one thing: presence. Not performance. Not polish. Presence.”</blockquote><p>Loren Michaels Harris · Host & creator</p><p>This is a continuation of purpose: making space for people to share what they have lived, learned, and carried forward.</p></div></div></section>
<section class="section light-section"><div class="wrap"><p class="eyebrow">A SPACE TO BE REAL</p><h2>Bring the whole story.</h2><div class="show-pillars">{pillars.map(([title,text])=><article><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>
<section class="section wrap"><p class="eyebrow">WHO WE ARE LOOKING FOR</p><h2>You don’t need to be famous.<br/><em>You need to be real.</em></h2><p>Purpose-driven voices. Lived experience. A willingness to share honestly. You may recognize yourself in one of these introductions.</p><div class="guest-profiles">{profiles.map(([title,text],i)=><article><p class="eyebrow">0{i+1}</p><h3>{title}</h3><p>{text}</p></article>)}</div></section>
<section class="section light-section" id="watch"><div class="wrap split"><div><p class="eyebrow">WATCH BATHROBE MOMENTS</p><h2>Pull up a chair.</h2></div><div><p>Start with a conversation below, or visit Loren’s official YouTube channel for the full archive and upcoming broadcasts.</p><a class="button" href={site.youtube}>Explore the show archive ↗</a></div></div></section>
<VideoGallery title="Every story opens a door." eyebrow="FEATURED CONVERSATIONS" clips={clips}/>
<section class="section wrap" id="guest-invitation"><div class="split"><div><p class="eyebrow">ARE YOU READY TO BE A FEATURED GUEST?</p><h2>What’s the story<br/><em>only you can tell?</em></h2></div><div><p>Bring your message into a thoughtful conversation with Loren. The process starts with an introduction and a discovery call to explore your story, audience, and fit.</p><p>We’ll discuss the conversation, production, scheduling, and promotional arrangements before confirming an appearance.</p><a class="button" href="#application">Introduce yourself ↓</a></div></div></section>
<section class="wrap"><GuestOffer/></section>
<section class="section wrap"><p class="eyebrow">THE DOOR IS OPEN</p><h2>Your voice belongs<br/><em>in the conversation.</em></h2><p>Tell us who you are, what you’d like to share, and why it matters. You don’t need a polished pitch. Start with the truth.</p></section>
<section class="section wrap guest-application" id="application"><div class="guest-form-layout"><div><p class="eyebrow">GUEST APPLICATION</p><h2>Let’s meet<br/>the person.</h2><p>Complete your introduction here. After submitting, schedule a pre-show discovery call with Loren.</p><a class="text-link" href={site.calendly}>Open Loren’s calendar ↗</a><p class="metadata">An application or call does not confirm an appearance. Fit, availability, and arrangements are confirmed directly.</p></div><InquiryForm service="guest"/></div></section>
</Base>
<script>
const film=document.querySelector<HTMLVideoElement>('[data-ambient-film]');const control=document.querySelector<HTMLButtonElement>('.ambient-toggle');
if(film&&control){control.hidden=false;let visible=false;let manuallyPaused=false;let manuallyStarted=false;const reduced=matchMedia('(prefers-reduced-motion: reduce)');const desktop=matchMedia('(min-width:1024px)');const connection=(navigator as Navigator & {connection?:EventTarget & {saveData?:boolean}}).connection;
function start(){if(!film!.src)film!.src=film!.dataset.src!;film!.hidden=false;void film!.play().catch(()=>{control!.textContent='Play introduction';});}
function sync(){const eligible=visible&&!document.hidden&&!manuallyPaused&&!document.querySelector('cinema-player[data-playing="true"]');if(eligible&&(manuallyStarted||(!reduced.matches&&desktop.matches&&!connection?.saveData)))start();else film!.pause();}
control.addEventListener('click',()=>{if(film.paused){manuallyPaused=false;manuallyStarted=true;sync();}else{manuallyPaused=true;film.pause();}});film.addEventListener('play',()=>control.textContent='Pause introduction');film.addEventListener('pause',()=>control.textContent='Play introduction');film.addEventListener('error',()=>{film.hidden=true;control.hidden=true;});new IntersectionObserver(entries=>{visible=entries[0].isIntersecting;sync();},{threshold:.2}).observe(film.parentElement!);document.addEventListener('visibilitychange',sync);document.addEventListener('lmh-play',()=>{manuallyPaused=true;film.pause();});reduced.addEventListener('change',()=>{manuallyStarted=false;sync();});desktop.addEventListener('change',sync);connection?.addEventListener('change',sync);
}
</script>
