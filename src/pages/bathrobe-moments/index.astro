---
import Base from '../../layouts/Base.astro';
import {Image} from 'astro:assets';
import {getCollection} from 'astro:content';
import portrait from '../../assets/loren-hat.jpg';
import logo from '../../assets/bathrobe-logo.png';
import GuestPackages from '../../components/GuestPackages.astro';
import CinemaPlayer from '../../components/CinemaPlayer.astro';
import {site} from '../../data/site';
const episodes = await getCollection('episodes', ({data}) => data.publish && data.approvalStatus === 'approved');
const featured = episodes.find(({id}) => id === 'geoff');
const conversations = ['mavis', 'lee', 'brett', 'grace', 'alice'].map(id => episodes.find(episode => episode.id === id)).filter(episode => episode !== undefined);
const videoId = (watchUrl:string) => new URL(watchUrl).searchParams.get('v') || '';
---
<Base title="Bathrobe Moments with Loren Michaels Harris" description="Real people. Real stories. Watch Bathrobe Moments conversations with Loren Michaels Harris, explore the show, or apply to share your story.">
  <section class="bathrobe-hero">
    <div class="wrap bathrobe-hero-grid">
      <div class="bathrobe-hero-copy">
        <div class="bathrobe-brand"><Image class="bathrobe-logo" src={logo} alt="" widths={[128,256]} sizes="128px" loading="eager" /><div><p class="bathrobe-series">Bathrobe Moments</p><p class="eyebrow">WITH LOREN MICHAELS HARRIS</p></div></div>
        <h1>Come as<br/><em>you are.</em></h1>
        <p class="bathrobe-lead">Real people. Real stories. Conversations about what we’ve lived through, what we’ve learned, and what we’re still figuring out.</p>
        <div class="actions"><a class="button" href="#watch">Watch a conversation <span aria-hidden="true">↓</span></a><a class="text-link" href="#application">Share your story <span aria-hidden="true">↗</span></a></div>
      </div>
      <figure class="bathrobe-portrait reveal">
        <Image src={portrait} alt="Loren Michaels Harris smiling and tipping his hat, wearing a pink shirt" widths={[480,720,960]} sizes="(max-width: 800px) 100vw, 48vw" loading="eager" fetchpriority="high" />
        <figcaption><span>YOUR HOST</span><strong>Loren Michaels Harris</strong></figcaption>
      </figure>
    </div>
    <div class="bathrobe-ribbon"><div class="wrap"><span>NO PERFECT INTRODUCTION REQUIRED.</span><a href={site.youtube}>Explore the full show archive <span aria-hidden="true">↗</span></a></div></div>
  </section>

  {featured && <section class="section show-feature" id="watch" aria-labelledby="featured-title">
    <div class="wrap">
      <div class="section-heading"><div><p class="eyebrow">PULL UP A CHAIR</p><h2 id="featured-title">Start with<br/><em>a real conversation.</em></h2></div><p class="show-section-note">Featuring Geoff Gunn<br/>Hosted by Loren Michaels Harris</p></div>
      <CinemaPlayer videoId={videoId(featured.data.watchUrl)} title={featured.data.title} poster="/media/episode-geoff.jpg" />
    </div>
  </section>}

  <section class="section episode-section" aria-labelledby="episodes-title">
    <div class="wrap">
      <div class="section-heading"><div><p class="eyebrow">MORE VOICES. MORE PERSPECTIVES.</p><h2 id="episodes-title">Find your next<br/>conversation.</h2></div><a class="text-link" href={site.youtube}>All episodes on YouTube <span aria-hidden="true">↗</span></a></div>
      <div class="conversation-grid">
        {conversations.map(episode => <article class="conversation-card reveal" aria-label={episode.data.title}>
          <CinemaPlayer videoId={videoId(episode.data.watchUrl)} title={episode.data.title} poster={`/media/episode-${episode.id}.jpg`} />
        </article>)}
        <a class="archive-card" href={site.youtube}><span class="eyebrow">THE CONVERSATION CONTINUES</span><h3>There’s always<br/>another story.</h3><p>Explore more guests and full broadcasts on Loren’s official YouTube channel.</p><span class="archive-link">Open the show archive <span aria-hidden="true">↗</span></span></a>
      </div>
    </div>
  </section>

  <section class="section light-section show-welcome" aria-labelledby="welcome-title">
    <div class="wrap show-welcome-grid">
      <div><p class="eyebrow">THIS IS BATHROBE MOMENTS</p><h2 id="welcome-title">Make yourself<br/>comfortable.</h2><p>You don’t need a polished answer to join this conversation. Bring your experiences, your questions, and a little room for someone else’s point of view.</p><p class="intro-caption">A six-second introduction to the show.</p></div>
      <div class="show-intro-film"><CinemaPlayer kind="local" src="/media/bathrobe-intro.mp4" title="Bathrobe Moments show introduction" poster="/media/bathrobe-intro.webp" ratio="1/1" /></div>
    </div>
  </section>

  <section class="section show-guest" id="application" aria-labelledby="guest-title">
    <div class="wrap">
      <div class="show-guest-grid"><div><p class="eyebrow">ON THE OTHER SIDE OF THE CONVERSATION</p><h2 id="guest-title">What’s the story<br/><em>only you can tell?</em></h2></div><div><p>Introduce yourself, the experience you want to share, and why the conversation matters to you. We’ll review your inquiry and discuss whether it’s a fit for the show.</p><a class="button" href="/bathrobe-moments/apply/">Apply to be a guest <span aria-hidden="true">↗</span></a><p class="guest-note">An inquiry does not confirm an appearance or place an order.</p></div></div>
      <details class="guest-options"><summary>Explore guest inquiry options <span aria-hidden="true">+</span></summary><div class="guest-options-content"><p>Choose an option if you have a preference. Details and availability are confirmed directly before you make a commitment.</p><GuestPackages/></div></details>
    </div>
  </section>
</Base>

<style>
  .bathrobe-hero{position:relative;overflow:hidden;background:radial-gradient(ellipse at 0% 25%,#47352455,transparent 65%),#11110f}
  .bathrobe-hero-grid{display:grid;grid-template-columns:1.03fr 1fr;gap:6%;align-items:center;padding-block:64px 56px}.bathrobe-hero-copy{padding-block:8px;min-width:0}
  .bathrobe-brand{display:flex;align-items:center;gap:20px;margin-bottom:28px}.bathrobe-logo{width:112px;height:auto;flex-shrink:0}.bathrobe-series{font:700 clamp(1.7rem,2.6vw,2.4rem)/1 'Barlow Condensed',sans-serif;margin:0 0 10px}.bathrobe-hero-copy .eyebrow{font-size:14px;line-height:1.6;letter-spacing:.1em;margin:0}
  .bathrobe-hero h1{font-size:clamp(4.8rem,8vw,8.4rem);line-height:.86;letter-spacing:-.025em;margin:0 0 32px}.bathrobe-lead{font-size:18px;line-height:1.65;max-width:490px;color:#d5cfc5;margin-bottom:32px}
  .bathrobe-hero .actions{gap:24px}.bathrobe-hero .button,.bathrobe-hero .text-link{font-size:16px}
  .bathrobe-portrait{position:relative;margin:0;overflow:hidden;align-self:stretch;background:#38332e;min-height:620px}.bathrobe-portrait img{width:100%;height:100%;object-fit:cover;object-position:center 28%;position:absolute}.bathrobe-portrait::after{content:'';position:absolute;inset:50% 0 0;background:linear-gradient(transparent,#101010d9);pointer-events:none}
  .bathrobe-portrait figcaption{position:absolute;bottom:30px;left:30px;right:30px;z-index:1;display:flex;flex-direction:column;gap:7px;color:#fff}.bathrobe-portrait figcaption span{font-size:14px;letter-spacing:.15em}.bathrobe-portrait figcaption strong{font:700 clamp(1.6rem,2.4vw,2.3rem)/1.1 'Barlow Condensed',sans-serif}
  .bathrobe-ribbon{border-top:1px solid #5c4f33;background:#d6b24d;color:#16130d}.bathrobe-ribbon .wrap{display:flex;justify-content:space-between;align-items:center;gap:20px;padding-block:22px}.bathrobe-ribbon span{font-size:14px;font-weight:700;letter-spacing:.08em}.bathrobe-ribbon a{font-size:16px;font-weight:600;text-decoration:none}.bathrobe-ribbon a span{font-size:20px;margin-left:10px}
  .show-feature{background:#171714}.show-feature .section-heading{align-items:end}.show-section-note{font-size:18px;line-height:1.6;color:#c4beb4;max-width:350px;margin:0 0 6px}
  .episode-section{border-bottom:1px solid #4b4332}.episode-section .section-heading .text-link{font-size:16px}.conversation-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:42px 24px}.conversation-card{min-width:0;background:#1b1b18;border:1px solid #37362e}
  .archive-card{display:flex;flex-direction:column;align-items:start;min-width:0;padding:34px;background:#d6b24d;color:#16130d;text-decoration:none;transition:background .2s ease}.archive-card:hover{background:#e5c46a}.archive-card .eyebrow{font-size:14px;color:#493b1d;letter-spacing:.12em;margin:0 0 25px}.archive-card h3{font-size:clamp(2.3rem,3.4vw,3.4rem);line-height:1;margin-bottom:22px}.archive-card p{font-size:18px;line-height:1.6;margin-bottom:32px}
  .archive-link{display:flex;align-items:center;justify-content:space-between;gap:20px;align-self:stretch;font-size:16px;font-weight:700;border-top:1px solid #806b32;padding-top:18px;margin-top:auto}.archive-link span{font-size:25px}
  .show-welcome{background:#f5f1e8;color:#171714}.show-welcome .eyebrow{color:#775820;font-size:14px}.show-welcome-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:9%;align-items:center}.show-welcome p{font-size:18px;line-height:1.65;max-width:570px;color:#4f4b43}.show-welcome .intro-caption{font-size:16px;margin:30px 0 0}.show-intro-film{max-width:470px;width:100%;justify-self:end}
  .show-guest{background:radial-gradient(ellipse at 100% 10%,#5e482f28,transparent 65%),#101010}.show-guest-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:8%;align-items:start}.show-guest-grid h2{margin-bottom:0}.show-guest-grid p{font-size:18px;line-height:1.65}.show-guest-grid .button{font-size:16px}.show-guest-grid .guest-note{font-size:14px;line-height:1.6;color:#bdb6a8;margin:20px 0 0}
  .guest-options{margin-top:64px;border-block:1px solid #514935}.guest-options summary{font-size:18px;min-height:76px;display:flex;align-items:center;justify-content:space-between;gap:24px;cursor:pointer;list-style:none}.guest-options summary::-webkit-details-marker{display:none}.guest-options summary span{font-size:30px;color:var(--gold);transition:transform .2s}.guest-options[open] summary span{transform:rotate(45deg)}.guest-options-content{padding:10px 0 32px}.guest-options-content>p{font-size:18px;max-width:760px}.guest-options-content :global(.package){padding:26px;border-color:#514935}.guest-options-content :global(.package p){font-size:18px;line-height:1.6}.guest-options-content :global(.package .eyebrow){font-size:14px}.guest-options-content :global(.package a){font-size:16px}
  @media(max-width:1100px){.bathrobe-hero-grid{gap:5%;padding-block:46px}.bathrobe-portrait{min-height:590px}.bathrobe-hero h1{font-size:clamp(4.2rem,8.4vw,6.5rem)}.bathrobe-hero .actions{align-items:start;flex-direction:column;gap:20px}.conversation-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.show-welcome-grid{gap:7%}.show-guest-grid{gap:6%}}
  @media(max-width:800px){.bathrobe-hero-grid{grid-template-columns:1fr;gap:36px;padding-block:40px 0}.bathrobe-hero-copy{padding:0}.bathrobe-logo{width:90px}.bathrobe-brand{gap:16px;margin-bottom:26px}.bathrobe-hero h1{font-size:clamp(4.4rem,15vw,7rem);margin-bottom:26px}.bathrobe-lead{max-width:590px}.bathrobe-hero .actions{flex-direction:row;align-items:center;gap:24px}.bathrobe-portrait{min-height:0;aspect-ratio:4/3;max-height:600px}.bathrobe-portrait img{object-position:center 30%}.bathrobe-ribbon .wrap{align-items:start;flex-direction:column;gap:12px;padding-block:20px}.show-feature .section-heading{align-items:start}.show-section-note{margin:0}.show-welcome-grid,.show-guest-grid{grid-template-columns:1fr;gap:36px}.show-intro-film{justify-self:start;max-width:500px}.show-guest-grid h2{max-width:650px}.guest-options{margin-top:44px}}
  @media(max-width:560px){.bathrobe-hero h1{font-size:clamp(4.4rem,19vw,6.2rem)}.bathrobe-hero .actions{gap:22px}.bathrobe-portrait{aspect-ratio:4/4.5;max-height:none}.bathrobe-portrait img{object-position:center 28%}.bathrobe-portrait figcaption{left:24px;right:24px;bottom:24px}.bathrobe-ribbon span{font-size:14px;line-height:1.5;letter-spacing:.04em}.conversation-grid{grid-template-columns:1fr;gap:28px}.archive-card{padding:30px;min-height:360px}.archive-card h3{font-size:3rem}.show-guest-grid h2,.show-welcome h2{font-size:clamp(2.8rem,12vw,4rem)}.guest-options summary{font-size:16px}}
  @media(prefers-reduced-motion:no-preference){.bathrobe-hero-copy{animation:show-arrive .65s ease-out}.bathrobe-portrait{animation:show-arrive .9s ease-out}@keyframes show-arrive{from{transform:translateY(18px);opacity:.7}to{transform:translateY(0);opacity:1}}}
</style>
