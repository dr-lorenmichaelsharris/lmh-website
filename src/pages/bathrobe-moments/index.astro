---
import Base from '../../layouts/Base.astro';
import {Image} from 'astro:assets';
import archive from '../../assets/show-brand.jpeg';
import GuestPackages from '../../components/GuestPackages.astro';
import ApprovedContent from '../../components/ApprovedContent.astro';
import {site} from '../../data/site';
---
<Base title="Bathrobe Moments with Loren Michaels Harris" description="Come as you are. Watch personal stories and honest conversations with Loren Michaels Harris, or apply to share your own."><section class="show-opening"><div class="wrap"><p class="eyebrow">WITH LOREN MICHAELS HARRIS</p><h1>Bathrobe<br/><em>Moments.</em></h1><div class="show-intro-bottom"><p>Real people. Real stories.<br/>Come as you are.</p><div class="actions"><a class="button" href={site.youtube}>Watch the conversations ↗</a><a class="text-link" href="#application">Share your story ↓</a></div></div><span class="show-opening-mark" aria-hidden="true">BM.</span></div></section><section class="section wrap split" id="watch"><div><p class="eyebrow">PULL UP A CHAIR</p><h2>There’s more<br/>to every person<br/><span class="gold-text">than the headline.</span></h2><p>Bathrobe Moments makes room for personal stories, hard-earned lessons, and honest conversations about life. Explore the available streams on Loren’s YouTube channel.</p><a class="button" href={site.youtube}>Browse the show ↗</a></div><figure class="archive-art"><Image src={archive} alt="Bathrobe Moments promotional artwork featuring Skip Sams, dated May 21, 2026" widths={[300,455]} sizes="(max-width:767px) 90vw, 35vw" loading="lazy"/><figcaption>From the show’s published promotional archive · May 2026</figcaption></figure></section><section class="section story-section" id="application"><div class="wrap split"><div><p class="eyebrow">ON THE OTHER SIDE OF THE CONVERSATION</p><h2>What’s the story<br/>only you can tell?</h2></div><div><p>Introduce yourself, the experience you want to share, and why the conversation matters to you. A guest inquiry starts a review; it does not confirm an appearance or place an order.</p><a class="button" href="/bathrobe-moments/apply/">Apply to be a guest ↗</a></div></div></section><section class="section wrap"><p class="eyebrow">FOR PROSPECTIVE GUESTS</p><h2>Explore the guest options.</h2><p>Include an option in your inquiry if you have a preference. Package details and availability are confirmed directly.</p><GuestPackages/></section><ApprovedContent kind="episodes"/></Base>
