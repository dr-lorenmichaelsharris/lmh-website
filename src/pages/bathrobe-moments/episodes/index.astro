---
export const prerender=false;
import Base from '../../../layouts/Base.astro';import EpisodeCard from '../../../components/EpisodeCard.astro';import {publicEpisodes} from '../../../lib/dashboard/public';import {broadcastStart} from '../../../lib/dashboard/time';
Astro.response.headers.set('Cache-Control','no-store');const {items}=await publicEpisodes();const past=items.filter(e=>!e.date||Date.parse(broadcastStart(e.date))+3600000<Date.now()).sort((a,b)=>b.date.localeCompare(a.date));const search=(Astro.url.searchParams.get('q')||'').slice(0,100);const filtered=search?past.filter(e=>(e.guest+' '+e.title+' '+e.description).toLowerCase().includes(search.toLowerCase())):past;const page=Math.max(1,Math.min(10000,Math.floor(Number(Astro.url.searchParams.get('page')))||1));const visible=filtered.slice((page-1)*12,page*12);
---
<Base title="Bathrobe Moments episode archive" description="Watch past Bathrobe Moments conversations with Loren Michaels Harris. Explore guests, their stories, and verified recordings."><section class="section wrap"><p class="breadcrumb"><a href="/bathrobe-moments/">Bathrobe Moments</a> / Episode archive</p><p class="eyebrow">THE CONVERSATIONS CONTINUE</p><h1>A story worth<br/><em>coming back to.</em></h1><p>Explore past conversations. Each episode keeps its own page as the show moves into a new week.</p><div class="actions"><a class="button" href="/bathrobe-moments/schedule/">Meet upcoming guests ↗</a><a class="text-link" href="/blog/">Visit the Blog ↗</a></div><form method="get" class="episode-search"><label for="episode-query">Find a guest or topic</label><div><input id="episode-query" type="search" name="q" value={search} maxlength="100"/><button class="button">Search</button></div></form><div class="episode-grid">{visible.map(e=><EpisodeCard episode={e}/>)}</div>{!visible.length&&<p>No published episodes match this search. <a href="/bathrobe-moments/episodes/">View all conversations</a>.</p>}<nav class="actions" aria-label="Archive pages">{page>1&&<a href={`?page=${page-1}&q=${encodeURIComponent(search)}`}>← Previous</a>}{page*12<filtered.length&&<a href={`?page=${page+1}&q=${encodeURIComponent(search)}`}>Next →</a>}</nav></section></Base>
