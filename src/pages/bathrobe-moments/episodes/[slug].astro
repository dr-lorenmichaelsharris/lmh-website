---
export const prerender=false;
import Base from '../../../layouts/Base.astro';import CinemaPlayer from '../../../components/CinemaPlayer.astro';import {publicEpisodes} from '../../../lib/dashboard/public';import {episodeBySlug} from '../../../lib/dashboard/store';import {admin} from '../../../lib/dashboard/auth';import {broadcastStart,showDate} from '../../../lib/dashboard/time';
Astro.response.headers.set('Cache-Control','no-store');const {items,available}=await publicEpisodes();let episode=items.find(e=>e.slug===Astro.params.slug);let preview=false;if(!episode&&Astro.url.searchParams.get('preview')==='1'){try{if(await admin(Astro.cookies.get('lmh-admin')?.value)){episode=await episodeBySlug(Astro.params.slug||'');if(episode?.trashedAt)episode=undefined;preview=!!episode;}}catch{}}if(!episode)Astro.response.status=available?404:503;const start=episode?.date?broadcastStart(episode.date):'';const ended=!!start&&Date.parse(start)+3600000<Date.now();const replay=episode?.replayUrl||'';let videoId='';try{const u=new URL(replay);if(['www.youtube.com','youtube.com','m.youtube.com'].includes(u.hostname))videoId=u.searchParams.get('v')||'';if(u.hostname==='youtu.be')videoId=u.pathname.slice(1);if(!/^[\w-]{11}$/.test(videoId))videoId='';}catch{}
const schema=episode&&videoId&&episode.recordingPublishedAt?{'@context':'https://schema.org','@type':'VideoObject',name:episode.title,description:episode.description,thumbnailUrl:new URL(episode.banner,'https://lorenmichaelsharris.com').href,uploadDate:episode.recordingPublishedAt,embedUrl:'https://www.youtube-nocookie.com/embed/'+videoId}:undefined;
---
<Base title={episode?.title||(available?'Episode not found':'Episode temporarily unavailable')} description={episode?.description||'Explore Bathrobe Moments conversations.'} image={episode?.banner} noindex={preview||!episode}>{episode?<article class="episode-detail episode-detail-v8 section wrap">{preview&&<p class="lineup-notice">Private preview. This episode is not published.</p>}<p class="breadcrumb"><a href="/bathrobe-moments/">Bathrobe Moments</a> / <a href="/bathrobe-moments/episodes/">Episodes</a></p><p class="eyebrow">{episode.cancelled?'CANCELED':start?showDate(start):'FROM THE SHOW ARCHIVE'}</p><h1>{episode.title}</h1><p class="episode-guest">With {episode.guest}</p>{episode.previousDate&&<p class="lineup-notice">Rescheduled from {episode.previousDate}. The date above is the current broadcast date.</p>}{!videoId&&<img class="episode-banner" src={episode.banner} alt={`${episode.guest} · Bathrobe Moments show banner`} width="1280" height="720" fetchpriority="high"/>}<div class="episode-reading"><p>{episode.description}</p>{episode.cancelled?<p class="lineup-notice">This episode has been canceled. Please check the weekly schedule for upcoming conversations.</p>:replay?<section aria-label="Episode recording"><h2 class="sr-only">Watch the conversation.</h2>{videoId?<CinemaPlayer title={episode.title} videoId={videoId} poster={episode.banner}/>:<a class="button" href={replay} target="_blank" rel="noopener noreferrer">Watch the verified recording ↗</a>}</section>:ended?<p class="lineup-notice">Replay pending. The recording will appear here when it is available.</p>:<div class="actions">{episode.liveUrl&&<a class="button" href={episode.liveUrl} target="_blank" rel="noopener noreferrer">Open the broadcast ↗</a>}{start&&<a class="text-link" href={`/bathrobe-moments/episodes/${episode.slug}/calendar.ics`}>Add to calendar ↓</a>}</div>}{episode.biography&&<section><h2>Meet {episode.guest}.</h2><p class="episode-prose">{episode.biography}</p></section>}{episode.highlights&&<section><h2>Conversation highlights.</h2><p class="episode-prose">{episode.highlights}</p></section>}{episode.transcript&&<details><summary>Read the supplied transcript</summary><p class="episode-prose">{episode.transcript}</p></details>}{episode.sourceUrl&&<p class="metadata"><a href={episode.sourceUrl} target="_blank" rel="noopener noreferrer">Original recording source ↗</a></p>}<div class="actions"><a class="button" href="/bathrobe-moments/schedule/">See the weekly lineup ↗</a><a class="text-link" href="/bathrobe-moments/#application">Bring your story to the show ↗</a></div></div>{schema&&<script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/>}</article>:<section class="section wrap"><h1>{available?'Episode not found.':'Episode temporarily unavailable.'}</h1>{!available&&<p>Please try again shortly. The episode has not been removed.</p>}<a class="button" href="/bathrobe-moments/episodes/">Explore published conversations ↗</a></section>}</Base>
