---
export const prerender=false;
import {chicagoDate} from '../../lib/dashboard/time';
import {randomUUID} from 'node:crypto';import {boundedForm} from '../../lib/dashboard/http';
import ApplicationTrashAction from '../../components/ApplicationTrashAction.astro';
import AdminEpisodes from '../../components/AdminEpisodes.astro';import {publicationMissing} from '../../lib/dashboard/presentation';import Admin from '../../layouts/Admin.astro';import {admin,csrf,safeMutation,logout,sendEmail,resumeToken} from '../../lib/dashboard/auth';import {query,databaseConfigured} from '../../lib/dashboard/db';import {episodes,applications,application,saveEpisode,trashEpisode,restoreEpisode,saveApplication,trashApplication,restoreApplication,audit,followUp,type Episode} from '../../lib/dashboard/store';import {storeBanner,validateEpisode} from '../../lib/dashboard/editor';import {calendarConfiguration,reconcile,discoverBookings} from '../../lib/dashboard/calendly';
Astro.response.headers.set('Cache-Control','no-store');Astro.response.headers.set('Referrer-Policy','strict-origin');let unavailable=false;const session=Astro.cookies.get('lmh-admin')?.value||'';let actor;try{actor=databaseConfigured()?await admin(session):undefined;}catch{unavailable=true;}if(!actor&&!unavailable)return Astro.redirect('/admin/login/',303);
let list:Episode[]=[],guests:Awaited<ReturnType<typeof applications>>=[],error='',notice='',saved=false,draft:Episode|undefined;
let tab=Astro.url.searchParams.get('tab')||'applications';
try{if(actor){list=await episodes();guests=await applications();if(Astro.request.method==='POST'){
 const length=Number(Astro.request.headers.get('content-length')||0);if(length>2300000)throw new Error('Upload a banner smaller than 2 MB.');const f=await boundedForm(Astro.request,2300000);if(!safeMutation(Astro.request,Astro.url,session,String(f.get('csrf')||'')))throw new Error('Your session could not be verified. Reload and retry.');const action=String(f.get('action')||'');const id=String(f.get('id')||'');
 if(action==='logout'){await logout(session);Astro.cookies.delete('lmh-admin',{path:'/'});return Astro.redirect('/admin/login/',303);}
 if(action==='verify-calendar'){await calendarConfiguration();notice='The read-only Calendly connection and both event types are verified.';}
 else if(action==='backup'){const tables=['lmh_episodes','lmh_applications','lmh_media','lmh_audit'];const records:Record<string,unknown>={};for(const table of tables){const rows=await query('SELECT * FROM '+table);records[table]=rows.map(row=>({...row,...(row.bytes?{bytes:Buffer.from(row.bytes as Uint8Array).toString('base64')}: {})}));}await audit(actor,'backup-downloaded','database');return new Response(JSON.stringify({version:1,createdAt:new Date().toISOString(),records}),{headers:{'Content-Type':'application/json','Content-Disposition':'attachment; filename="lmh-dashboard-backup.json"','Cache-Control':'no-store'}});}
 else if(action==='trash-episode'||action==='restore-episode'){const old=list.find(e=>e.id===id);if(!old)throw new Error('Episode not found.');await saveEpisode(action==='trash-episode'?trashEpisode(old,actor):restoreEpisode(old));await audit(actor,action,id);return Astro.redirect('/admin/?tab=episodes&status='+ (action==='trash-episode'?'trash':'drafts')+'&saved=1',303);}
 else if(action==='save-episode'){const old=list.find(e=>e.id===id);if(old?.trashedAt)throw new Error('Restore this episode as a draft before editing.');const text=(key:string)=>String(f.get(key)||'').trim();draft={id:old?.id||randomUUID(),slug:old?.slug||text('slug'),guest:text('guest'),title:text('title'),biography:text('biography'),description:text('description'),date:text('date'),banner:old?.banner||'',liveUrl:text('liveUrl'),replayUrl:text('replayUrl'),highlights:text('highlights'),transcript:text('transcript'),published:f.get('intent')==='publish',cancelled:f.get('cancelled')==='yes',legacy:old?.legacy,sourceUrl:old?.sourceUrl,recordingPublishedAt:text('recordingPublishedAt'),previousDate:old?.date&&old.date!==text('date')?old.date:old?.previousDate};const banner=f.get('banner');if(banner instanceof File&&banner.size)draft.banner=await storeBanner(banner);if(draft.published&&!draft.legacy&&Object.values(publicationMissing(draft)).some(Boolean))throw new Error('Complete the highlighted fields before publishing.');validateEpisode(draft);if(draft.published&&!draft.cancelled&&draft.date&&list.some(e=>e.id!==draft!.id&&e.published&&!e.trashedAt&&!e.cancelled&&e.date===draft!.date))throw new Error('Another published episode already uses that date. Reschedule it or keep this episode as a draft.');await saveEpisode(draft);await audit(actor,'episode-saved',draft.id);return Astro.redirect('/admin/?tab=episodes&edit='+draft.id+'&saved=1',303);}
 if(action==='trash-application'||action==='restore-application'){const a=await application(id);if(!a)throw new Error('Application not found.');await saveApplication(action==='trash-application'?trashApplication(a,actor):restoreApplication(a));await audit(actor,action,id);return Astro.redirect('/admin/?tab=applications&status='+(action==='trash-application'?'trash':'active')+'&saved=1',303);}
 if(['save-application','reconcile','send-resume'].includes(action)){const a=await application(id);if(!a)throw new Error('Application not found.');if(a.trashedAt)throw new Error('Restore this application before making changes.');if(action==='save-application'){a.notes=String(f.get('notes')||'').slice(0,10000);a.discoveryCompleted=f.get('discoveryCompleted')==='yes';a.closed=f.get('closed')==='yes';await saveApplication(a);}if(action==='reconcile'){await discoverBookings([a]);await reconcile((await application(id))!);}if(action==='send-resume'){if(a.delivery!=='accepted')throw new Error('Application delivery is incomplete. Ask the guest to retry before scheduling.');const link=Astro.url.origin+'/bathrobe-moments/booking/?token='+encodeURIComponent(resumeToken(a.id));if(!await sendEmail(a.email,'Your Bathrobe Moments booking steps','Continue privately: '+link+'\n\nReserve your show date, then schedule discovery before your broadcast.'))throw new Error('The resume email could not be sent.');}await audit(actor,action,a.id);return Astro.redirect('/admin/?tab=applications&guest='+a.id+'&saved=1',303);}
 if(!notice)throw new Error('Choose a supported action.');
}}}catch(e){error=e instanceof Error?e.message:'The dashboard is temporarily unavailable.';Astro.response.status=422;}
const selected=guests.find(a=>a.id===Astro.url.searchParams.get('guest'));const selectedEpisode=draft||list.find(e=>e.id===Astro.url.searchParams.get('edit'));const editing=tab==='episodes'&&(Astro.url.searchParams.has('new')||!!selectedEpisode);const blank:Episode={id:'',slug:'',title:'',guest:'',biography:'',description:'',date:'',banner:'',liveUrl:'',replayUrl:'',highlights:'',transcript:'',published:false,cancelled:false};const source=guests.find(a=>!a.trashedAt&&a.id===Astro.url.searchParams.get('from'));const editor=selectedEpisode||(source?{...blank,guest:source.name,biography:source.biography,title:source.topic.slice(0,200),description:source.topic,date:source.show?.status==='active'?chicagoDate(new Date(source.show.start)):''}:blank);const persisted=list.some(e=>e.id===editor.id);saved=Astro.url.searchParams.get('saved')==='1';const applicationStatus=Astro.url.searchParams.get('status')==='trash'?'trash':'active';const trashConfirmation=guests.find(a=>a.id===Astro.url.searchParams.get('trash')&&!a.trashedAt);const filtered=guests.filter(a=>tab==='follow-up'?!a.trashedAt&&!['Ready for team review','Discovery booked','Closed by team'].includes(followUp(a)):applicationStatus==='trash'?!!a.trashedAt:!a.trashedAt);
---
<Admin title="Show dashboard"><div class="admin-actions"><h1>Behind the show.</h1>{actor&&<form method="post"><input type="hidden" name="csrf" value={csrf(session)}/><input type="hidden" name="action" value="logout"/><button class="admin-button">Sign out</button></form>}</div><p>Manage applications, prepare the weekly lineup, and publish each conversation when it is ready.</p>{error&&<div class="admin-alert" role="alert">{error} Your entered episode text is retained below. If needed, select the banner again.</div>}{notice&&<p class="admin-alert" role="status">{notice}</p>}{saved&&<p class="admin-alert" role="status">Changes saved.</p>}{unavailable?<p>The database is temporarily unavailable. No public content or bookings have been changed.</p>:<><nav class="admin-nav" aria-label="Dashboard"><a href="/admin/?tab=applications" aria-current={tab==='applications'?'page':undefined}>Applications ({guests.filter(a=>!a.trashedAt).length})</a><a href="/admin/?tab=episodes" aria-current={tab==='episodes'?'page':undefined}>Episodes ({list.length})</a><a href="/admin/?tab=follow-up" aria-current={tab==='follow-up'?'page':undefined}>Follow-up</a><a href="/admin/?tab=settings" aria-current={tab==='settings'?'page':undefined}>Settings & backups</a><a href="/bathrobe-moments/schedule/">View lineup ↗</a></nav>
{tab==='applications'&&<><nav class="admin-nav" aria-label="Application status"><a href="/admin/?tab=applications" aria-current={applicationStatus==='active'?'page':undefined}>Applications ({guests.filter(a=>!a.trashedAt).length})</a><a href="/admin/?tab=applications&status=trash" aria-current={applicationStatus==='trash'?'page':undefined}>Trash ({guests.filter(a=>a.trashedAt).length})</a></nav>{trashConfirmation&&<section class="admin-card" aria-labelledby="application-trash-heading"><h2 id="application-trash-heading">Move “{trashConfirmation.name}” to Trash?</h2><p>The application will be removed from the active list and follow-up. Its details remain recoverable.</p><p><strong>This does not cancel Calendly bookings or remove published episodes.</strong></p><form method="post"><input type="hidden" name="csrf" value={csrf(session)}/><input type="hidden" name="action" value="trash-application"/><input type="hidden" name="id" value={trashConfirmation.id}/><div class="admin-actions"><button class="admin-button danger">Confirm move to Trash</button><a href="/admin/?tab=applications">Keep application</a></div></form></section>}</>}
{tab==='settings'?<section class="admin-card"><h2>Connections and backups.</h2><p>The database is connected. Changes here survive GitHub deployments.</p><p>Calendly credential: {process.env.CALENDLY_API_TOKEN?'Configured':'Not configured'}. Guest booking: {process.env.GUEST_BOOKING_ENABLED==='true'?'Enabled':'Not enabled yet'}.</p><div class="admin-actions">{[['verify-calendar','Verify Calendly connection'],['backup','Download private backup']].map(([action,label])=><form method="post"><input type="hidden" name="csrf" value={csrf(session)}/><input type="hidden" name="action" value={action}/><button class="admin-button">{label}</button></form>)}</div><p class="admin-note">Backups contain private application details and banner files. Store them securely. Administrator sessions and sign-in tokens are not exported.</p></section>:tab==='episodes'?<AdminEpisodes list={list} editor={editor} editing={editing} persisted={persisted} csrfToken={csrf(session)} error={error} url={Astro.url}/>:selected?<section class="admin-card"><p class="admin-status">{followUp(selected)}</p><h2>{selected.name}</h2><p><a href={`mailto:${selected.email}`}>{selected.email}</a> · {selected.phone}</p><h3>Biography</h3><p class="admin-detail">{selected.biography}</p><h3>Proposed topic</h3><p class="admin-detail">{selected.topic}</p><p>Delivery: {selected.delivery}</p><div class="admin-grid">{(['show','discovery'] as const).map(kind=><div class="admin-card"><h3>{kind==='show'?'Show reservation':'Discovery call'}</h3><p>{selected[kind]?`${selected[kind]!.status} · ${selected[kind]!.start}`:'Not booked'}</p><p class="admin-note">Stored times are UTC. Public guest steps show Chicago time.</p>{selected[kind]?.rescheduleUrl&&<p><a href={selected[kind]!.rescheduleUrl} target="_blank" rel="noopener noreferrer">Reschedule in Calendly ↗</a></p>}{selected[kind]?.cancelUrl&&selected[kind]?.status==='active'&&<p><a href={selected[kind]!.cancelUrl} target="_blank" rel="noopener noreferrer">Cancel in Calendly ↗</a></p>}</div>)}</div>{!selected.trashedAt&&<><form method="post"><input type="hidden" name="csrf" value={csrf(session)}/><input type="hidden" name="id" value={selected.id}/><input type="hidden" name="action" value="save-application"/><label for="notes">Private team notes</label><textarea id="notes" name="notes" maxlength="10000">{selected.notes}</textarea><label><input type="checkbox" name="discoveryCompleted" value="yes" checked={selected.discoveryCompleted}/>The team confirms discovery has taken place</label><label><input type="checkbox" name="closed" value="yes" checked={selected.closed}/>Close this application and remove it from follow-up</label><button class="admin-button primary">Save notes</button></form><div class="admin-actions">{['reconcile','send-resume'].map(action=><form method="post"><input type="hidden" name="csrf" value={csrf(session)}/><input type="hidden" name="id" value={selected.id}/><input type="hidden" name="action" value={action}/><button class="admin-button">{action==='reconcile'?'Refresh Calendly status':'Email private resume link'}</button></form>)}<a class="admin-button" href={`/admin/?tab=episodes&new=1&from=${selected.id}`}>Prepare episode +</a></div></>}<ApplicationTrashAction guest={selected} csrfToken={csrf(session)}/><p class="admin-note">Guest headshots were delivered privately as application attachments. They are not published here.</p></section>:<div class="admin-grid">{filtered.length?filtered.map(a=><article class="admin-card"><p class="admin-status">{followUp(a)}</p><h2>{a.name}</h2><p>{a.email}</p><p>{a.topic}</p><a href={`/admin/?tab=applications&guest=${a.id}`}>Review application →</a><ApplicationTrashAction guest={a} csrfToken={csrf(session)}/></article>):<p>No applications need attention here.</p>}</div>}</>}
</Admin>
