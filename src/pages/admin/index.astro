---
export const prerender=false;
import {chicagoDate} from '../../lib/dashboard/time';
import {randomUUID} from 'node:crypto';import {boundedForm} from '../../lib/dashboard/http';
import Admin from '../../layouts/Admin.astro';import {admin,csrf,safeMutation,logout,sendEmail,resumeToken} from '../../lib/dashboard/auth';import {query,databaseConfigured} from '../../lib/dashboard/db';import {episodes,applications,application,saveEpisode,saveApplication,audit,followUp,type Episode} from '../../lib/dashboard/store';import {storeBanner,validateEpisode} from '../../lib/dashboard/editor';import {calendarConfiguration,reconcile,discoverBookings} from '../../lib/dashboard/calendly';
Astro.response.headers.set('Cache-Control','no-store');Astro.response.headers.set('Referrer-Policy','strict-origin');let unavailable=false;const session=Astro.cookies.get('lmh-admin')?.value||'';let actor;try{actor=databaseConfigured()?await admin(session):undefined;}catch{unavailable=true;}if(!actor&&!unavailable)return Astro.redirect('/admin/login/',303);
let list:Episode[]=[],guests:Awaited<ReturnType<typeof applications>>=[],error='',notice='',saved=false,draft:Episode|undefined;
let tab=Astro.url.searchParams.get('tab')||'applications';
try{if(actor){list=await episodes();guests=await applications();if(Astro.request.method==='POST'){
 const length=Number(Astro.request.headers.get('content-length')||0);if(length>2300000)throw new Error('Upload a banner smaller than 2 MB.');const f=await boundedForm(Astro.request,2300000);if(!safeMutation(Astro.request,Astro.url,session,String(f.get('csrf')||'')))throw new Error('Your session could not be verified. Reload and retry.');const action=String(f.get('action')||'');const id=String(f.get('id')||'');
 if(action==='logout'){await logout(session);Astro.cookies.delete('lmh-admin',{path:'/'});return Astro.redirect('/admin/login/',303);}
 if(action==='verify-calendar'){await calendarConfiguration();notice='The read-only Calendly connection and both event types are verified.';}
 else if(action==='backup'){const tables=['lmh_episodes','lmh_applications','lmh_media','lmh_audit'];const records:Record<string,unknown>={};for(const table of tables){const rows=await query('SELECT * FROM '+table);records[table]=rows.map(row=>({...row,...(row.bytes?{bytes:Buffer.from(row.bytes as Uint8Array).toString('base64')}: {})}));}await audit(actor,'backup-downloaded','database');return new Response(JSON.stringify({version:1,createdAt:new Date().toISOString(),records}),{headers:{'Content-Type':'application/json','Content-Disposition':'attachment; filename="lmh-dashboard-backup.json"','Cache-Control':'no-store'}});}
 else if(action==='save-episode'){const old=list.find(e=>e.id===id);const text=(key:string)=>String(f.get(key)||'').trim();draft={id:old?.id||randomUUID(),slug:old?.slug||text('slug'),guest:text('guest'),title:text('title'),biography:text('biography'),description:text('description'),date:text('date'),banner:old?.banner||'',liveUrl:text('liveUrl'),replayUrl:text('replayUrl'),highlights:text('highlights'),transcript:text('transcript'),published:f.get('published')==='yes',cancelled:f.get('cancelled')==='yes',legacy:old?.legacy,sourceUrl:old?.sourceUrl,recordingPublishedAt:text('recordingPublishedAt'),previousDate:old?.date&&old.date!==text('date')?old.date:old?.previousDate};const banner=f.get('banner');if(banner instanceof File&&banner.size)draft.banner=await storeBanner(banner);validateEpisode(draft);if(draft.published&&!draft.cancelled&&draft.date&&list.some(e=>e.id!==draft!.id&&e.published&&!e.cancelled&&e.date===draft!.date))throw new Error('Another published episode already uses that date. Reschedule it or keep this episode as a draft.');await saveEpisode(draft);await audit(actor,'episode-saved',draft.id);return Astro.redirect('/admin/?tab=episodes&edit='+draft.id+'&saved=1',303);}
 if(['save-application','reconcile','send-resume'].includes(action)){const a=await application(id);if(!a)throw new Error('Application not found.');if(action==='save-application'){a.notes=String(f.get('notes')||'').slice(0,10000);a.discoveryCompleted=f.get('discoveryCompleted')==='yes';a.closed=f.get('closed')==='yes';await saveApplication(a);}if(action==='reconcile'){await discoverBookings([a]);await reconcile((await application(id))!);}if(action==='send-resume'){if(a.delivery!=='accepted')throw new Error('Application delivery is incomplete. Ask the guest to retry before scheduling.');const link=Astro.url.origin+'/bathrobe-moments/booking/?token='+encodeURIComponent(resumeToken(a.id));if(!await sendEmail(a.email,'Your Bathrobe Moments booking steps','Continue privately: '+link+'\n\nReserve your show date, then schedule discovery before your broadcast.'))throw new Error('The resume email could not be sent.');}await audit(actor,action,a.id);return Astro.redirect('/admin/?tab=applications&guest='+a.id+'&saved=1',303);}
 if(!notice)throw new Error('Choose a supported action.');
}}}catch(e){error=e instanceof Error?e.message:'The dashboard is temporarily unavailable.';Astro.response.status=422;}
const selected=guests.find(a=>a.id===Astro.url.searchParams.get('guest'));const selectedEpisode=draft||list.find(e=>e.id===Astro.url.searchParams.get('edit'));const editing=tab==='episodes'&&(Astro.url.searchParams.has('new')||!!selectedEpisode);const blank:Episode={id:'',slug:'',title:'',guest:'',biography:'',description:'',date:'',banner:'',liveUrl:'',replayUrl:'',highlights:'',transcript:'',published:false,cancelled:false};const source=guests.find(a=>a.id===Astro.url.searchParams.get('from'));const editor=selectedEpisode||(source?{...blank,guest:source.name,biography:source.biography,title:source.topic.slice(0,200),description:source.topic,date:source.show?.status==='active'?chicagoDate(new Date(source.show.start)):''}:blank);const persisted=list.some(e=>e.id===editor.id);saved=Astro.url.searchParams.get('saved')==='1';const filtered=tab==='follow-up'?guests.filter(a=>!['Ready for team review','Discovery booked','Closed by team'].includes(followUp(a))):guests;
---
<Admin title="Show dashboard"><div class="admin-actions"><h1>Behind the show.</h1>{actor&&<form method="post"><input type="hidden" name="csrf" value={csrf(session)}/><input type="hidden" name="action" value="logout"/><button class="admin-button">Sign out</button></form>}</div><p>Manage applications, prepare the weekly lineup, and publish each conversation when it is ready.</p>{error&&<div class="admin-alert" role="alert">{error} Your entered episode text is retained below. If needed, select the banner again.</div>}{notice&&<p class="admin-alert" role="status">{notice}</p>}{saved&&<p class="admin-alert" role="status">Changes saved.</p>}{unavailable?<p>The database is temporarily unavailable. No public content or bookings have been changed.</p>:<><nav class="admin-nav" aria-label="Dashboard"><a href="/admin/?tab=applications" aria-current={tab==='applications'?'page':undefined}>Applications ({guests.length})</a><a href="/admin/?tab=episodes" aria-current={tab==='episodes'?'page':undefined}>Episodes ({list.length})</a><a href="/admin/?tab=follow-up" aria-current={tab==='follow-up'?'page':undefined}>Follow-up</a><a href="/admin/?tab=settings" aria-current={tab==='settings'?'page':undefined}>Settings & backups</a><a href="/bathrobe-moments/schedule/">View lineup ↗</a></nav>
{tab==='settings'?<section class="admin-card"><h2>Connections and backups.</h2><p>The database is connected. Changes here survive GitHub deployments.</p><p>Calendly credential: {process.env.CALENDLY_API_TOKEN?'Configured':'Not configured'}. Guest booking: {process.env.GUEST_BOOKING_ENABLED==='true'?'Enabled':'Not enabled yet'}.</p><div class="admin-actions">{[['verify-calendar','Verify Calendly connection'],['backup','Download private backup']].map(([action,label])=><form method="post"><input type="hidden" name="csrf" value={csrf(session)}/><input type="hidden" name="action" value={action}/><button class="admin-button">{label}</button></form>)}</div><p class="admin-note">Backups contain private application details and banner files. Store them securely. Administrator sessions and sign-in tokens are not exported.</p></section>:tab==='episodes'?editing?<form method="post" enctype="multipart/form-data" class="admin-card"><input type="hidden" name="csrf" value={csrf(session)}/><input type="hidden" name="action" value="save-episode"/><input type="hidden" name="id" value={editor.id}/><h2>{editor.id?'Edit episode':'Prepare a new episode'}</h2><div class="admin-grid"><div><label for="guest">Guest name *</label><input id="guest" name="guest" value={editor.guest} maxlength="200" required/></div><div><label for="title">Episode title / topic *</label><input id="title" name="title" value={editor.title} maxlength="200" required/></div><div><label for="slug">Permanent URL slug *</label><input id="slug" name="slug" value={editor.slug} maxlength="120" pattern="[a-z0-9]+(-[a-z0-9]+)*" required readonly={persisted}/><p class="admin-note">The URL stays unchanged when the show is rescheduled.</p></div><div><label for="date">Broadcast date</label><input type="date" id="date" name="date" value={editor.date}/><p class="admin-note">Monday–Friday, 10 AM America/Chicago. Calendar bookings are managed in Calendly.</p></div></div><label for="banner">Finished show banner</label>{editor.banner&&<img class="admin-banner" src={editor.banner} alt="Current guest-show banner"/>}<input type="file" id="banner" name="banner" accept="image/jpeg,image/png,image/webp"/><p class="admin-note">JPEG, PNG, WebP · maximum 2 MB. This upload becomes public only when this episode is published.</p>{(['biography','description','highlights','transcript'] as const).map(key=><><label for={key}>{({biography:'Guest biography',description:'Episode description',highlights:'Highlights (optional)',transcript:'Transcript (optional)'})[key]}</label><textarea id={key} name={key} maxlength={key==='transcript'?50000:key==='highlights'?10000:5000} rows={key==='transcript'?8:4}>{editor[key]}</textarea></>)}<div class="admin-grid"><div><label for="liveUrl">Public live-broadcast link</label><input type="url" id="liveUrl" name="liveUrl" value={editor.liveUrl}/></div><div><label for="replayUrl">Verified replay link</label><input type="url" id="replayUrl" name="replayUrl" value={editor.replayUrl}/></div></div><label for="recordingPublishedAt">Recording publication date (verified, optional)</label><input type="date" id="recordingPublishedAt" name="recordingPublishedAt" value={editor.recordingPublishedAt}/><label><input type="checkbox" name="published" value="yes" checked={editor.published}/>Publish this episode</label><label><input type="checkbox" name="cancelled" value="yes" checked={editor.cancelled}/>Mark episode canceled (does not cancel Calendly reservations)</label><div class="admin-actions"><button class="admin-button primary">Save episode</button>{persisted&&<a class="admin-button" href={`/bathrobe-moments/episodes/${editor.slug}/?preview=1`} target="_blank" rel="noopener noreferrer">Preview episode ↗</a>}<a href="/admin/?tab=episodes">Back to episodes</a></div></form>:<><a class="admin-button primary" href="/admin/?tab=episodes&new=1">Add an episode +</a><div class="admin-grid" style="margin-top:24px">{list.map(e=><article class="admin-card"><p class="admin-status">{e.cancelled?'Canceled':e.published?'Published':'Draft'} · {e.date||'Undated source recording'}</p><h2>{e.title}</h2><p>{e.guest}</p><a href={`/admin/?tab=episodes&edit=${e.id}`}>Edit episode →</a></article>)}</div></>:selected?<section class="admin-card"><p class="admin-status">{followUp(selected)}</p><h2>{selected.name}</h2><p><a href={`mailto:${selected.email}`}>{selected.email}</a> · {selected.phone}</p><h3>Biography</h3><p class="admin-detail">{selected.biography}</p><h3>Proposed topic</h3><p class="admin-detail">{selected.topic}</p><p>Delivery: {selected.delivery}</p><div class="admin-grid">{(['show','discovery'] as const).map(kind=><div class="admin-card"><h3>{kind==='show'?'Show reservation':'Discovery call'}</h3><p>{selected[kind]?`${selected[kind]!.status} · ${selected[kind]!.start}`:'Not booked'}</p><p class="admin-note">Stored times are UTC. Public guest steps show Chicago time.</p>{selected[kind]?.rescheduleUrl&&<p><a href={selected[kind]!.rescheduleUrl} target="_blank" rel="noopener noreferrer">Reschedule in Calendly ↗</a></p>}{selected[kind]?.cancelUrl&&selected[kind]?.status==='active'&&<p><a href={selected[kind]!.cancelUrl} target="_blank" rel="noopener noreferrer">Cancel in Calendly ↗</a></p>}</div>)}</div><form method="post"><input type="hidden" name="csrf" value={csrf(session)}/><input type="hidden" name="id" value={selected.id}/><input type="hidden" name="action" value="save-application"/><label for="notes">Private team notes</label><textarea id="notes" name="notes" maxlength="10000">{selected.notes}</textarea><label><input type="checkbox" name="discoveryCompleted" value="yes" checked={selected.discoveryCompleted}/>The team confirms discovery has taken place</label><label><input type="checkbox" name="closed" value="yes" checked={selected.closed}/>Close this application and remove it from follow-up</label><button class="admin-button primary">Save notes</button></form><div class="admin-actions">{['reconcile','send-resume'].map(action=><form method="post"><input type="hidden" name="csrf" value={csrf(session)}/><input type="hidden" name="id" value={selected.id}/><input type="hidden" name="action" value={action}/><button class="admin-button">{action==='reconcile'?'Refresh Calendly status':'Email private resume link'}</button></form>)}<a class="admin-button" href={`/admin/?tab=episodes&new=1&from=${selected.id}`}>Prepare episode +</a></div><p class="admin-note">Guest headshots were delivered privately as application attachments. They are not published here.</p></section>:<div class="admin-grid">{filtered.length?filtered.map(a=><article class="admin-card"><p class="admin-status">{followUp(a)}</p><h2>{a.name}</h2><p>{a.email}</p><p>{a.topic}</p><a href={`/admin/?tab=applications&guest=${a.id}`}>Review application →</a></article>):<p>No applications need attention here.</p>}</div>}</>}
</Admin>
