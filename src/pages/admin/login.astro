---
export const prerender=false;
import {boundedForm} from '../../lib/dashboard/http';
import Admin from '../../layouts/Admin.astro';import {createLogin,owner,limit,sendEmail} from '../../lib/dashboard/auth';import {databaseConfigured,localDatabase} from '../../lib/dashboard/db';
Astro.response.headers.set('Cache-Control','no-store');let sent=false,error='',localLink='';
if(Astro.request.method==='POST'){try{if(Astro.request.headers.get('origin')!==Astro.url.origin)throw new Error('Please submit from this website.');const form=await boundedForm(Astro.request,8192);const email=String(form.get('email')||'').trim().toLowerCase();if(!await limit('login:'+Astro.clientAddress,5))throw new Error('Please wait before requesting another link.');if(email===owner()){const token=await createLogin(email);const link=Astro.url.origin+'/admin/sign-in/?token='+encodeURIComponent(token);if(!await sendEmail(email,'Your LMH dashboard sign-in link','Sign in to the LMH show dashboard. This link expires in 10 minutes and can be used once:\n\n'+link))throw new Error('The sign-in email could not be sent. Please retry.');if(localDatabase())localLink=link;}sent=true;}catch(e){const message=e instanceof Error?e.message:'';error=['Please submit from this website.','Please wait before requesting another link.','The sign-in email could not be sent. Please retry.'].includes(message)?message:'Sign-in is temporarily unavailable. Please retry or contact the team.';}}
if(!databaseConfigured())Astro.response.status=503;
---
<Admin title="Administrator sign-in"><section class="admin-login"><p class="eyebrow">PRIVATE EDITOR</p><h1>Your show.<br/>Your dashboard.</h1>{!databaseConfigured()?<p>The dashboard database is not configured yet. Public inquiries remain available.</p>:sent?<div class="admin-alert"><h2>Check your email.</h2><p>If this address is authorized, a sign-in link has been sent. It expires in 10 minutes.</p>{localLink&&<a href={localLink}>Local development sign-in (no email sent)</a>}</div>:<form method="post"><p>Enter the authorized administrator email to receive a secure sign-in link.</p>{error&&<p role="alert" class="admin-alert">{error}</p>}<label for="email">Administrator email</label><input id="email" type="email" name="email" required autocomplete="email" maxlength="254"/><div class="admin-actions"><button class="admin-button primary">Email sign-in link</button></div></form>}</section></Admin>
