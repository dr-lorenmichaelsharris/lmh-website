---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import ApprovedContent from '../components/ApprovedContent.astro';
import CinemaPlayer from '../components/CinemaPlayer.astro';
---
<Base title="For the people behind the event" description="Speaker footage, a short biography, and a direct starting point for organizers, interviewers, and media requests.">
<PageIntro title="For the people behind the event." eyebrow="MEDIA & ORGANIZER RESOURCES" description="Get a feel for Loren’s work, prepare for your conversation, and request the materials that fit your event or feature."><a class="button" href="/contact/?service=general">Request media materials ↗</a></PageIntro>
<section class="section wrap"><div class="section-heading"><div><p class="eyebrow">SPEAKER FOOTAGE</p><h2>See Loren<br/>in the room.</h2></div><a class="text-link" href="/services/speaking/">Explore speaking ↗</a></div><CinemaPlayer kind="local" src="/media/loren-speaker-reel.mp4" title="Dr. Loren Michaels Harris · Speaker Reel" poster="/media/loren-speaker-reel.webp"/></section>
<section class="section light-section"><div class="wrap split"><div><p class="eyebrow">SHORT BIOGRAPHY</p><h2>Meet Loren<br/>Michaels Harris.</h2></div><div><p>Loren Michaels Harris is a speaker, coach, keynote writer, and the host of Bathrobe Moments. His work connects personal storytelling with the P3 themes of Pain, Perspective, and Possibility.</p><p>Drawing on his own life experiences, including foster care, Loren invites audiences to consider the stories they carry and the way they connect with other people.</p><a class="text-link" href="/about/">Read the full introduction ↗</a></div></div></section>
<section class="section wrap"><div class="section-heading"><div><p class="eyebrow">PREPARING AN EVENT OR A FEATURE?</p><h2>Tell us what<br/>you’re putting together.</h2></div></div><div class="topic-columns"><article><h3>Biography & introduction</h3><p>Request an introduction suited to your audience, publication, or event format. Include your word count and deadline.</p></article><article><h3>Portraits & imagery</h3><p>Describe your intended use and required size so the right photograph and its credit can be confirmed.</p></article><article><h3>Interviews & event details</h3><p>Share your topic, audience, timing, and format. Availability and practical requirements are discussed directly.</p></article></div><div class="media-actions"><a class="button" href="/contact/?service=general">Request media materials ↗</a></div></section>
<ApprovedContent kind="downloads"/>
</Base>
<style>.media-actions{margin-top:40px}</style>
