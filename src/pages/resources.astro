---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import {Image} from 'astro:assets';
import showLogo from '../assets/bathrobe-logo.png';
import book from '../assets/book.jpg';
import {site} from '../data/site';
---
<Base title="Read. Watch. Find your starting point." description="Explore Bathrobe Moments, Loren’s writing, The Mindset Revolution, and resources for your next event or conversation.">
<PageIntro title="Stay curious." eyebrow="READ / WATCH / EXPLORE" description="Stories to spend time with. Conversations that open another perspective. A practical starting point for working together."/>
<section class="section wrap"><div class="resource-show"><a class="resource-show-art reveal" href="/bathrobe-moments/" aria-label="Explore Bathrobe Moments"><Image src={showLogo} alt="Bathrobe Moments show logo with a silver robe and gold lettering" widths={[320,500,700]} sizes="(max-width:767px) calc(100vw - 40px), 32vw" format="webp" loading="eager"/></a><div><p class="eyebrow">WATCH THE CONVERSATIONS</p><h2>Bathrobe<br/>Moments</h2><p>Meet people with a story to tell. Explore selected full conversations and the official broadcast archive.</p><a class="button" href="/bathrobe-moments/">Find a conversation ↗</a></div></div></section>
<section class="section light-section"><div class="wrap"><p class="eyebrow">CHOOSE WHERE TO GO NEXT</p><div class="resource-links"><article><h2>The Journal</h2><p>Personal reflections, stories, and archival show notes from Loren.</p><a class="text-link" href="/blog/">Explore the writing ↗</a></article><article><h2>The Mindset Revolution</h2><p>A twelve-week masterclass and coaching experience. Explore the twelve classes, private coaching, and work you can develop.</p><a class="text-link" href="/the-mindset-revolution/">Explore the program ↗</a></article><article><h2>For event organizers</h2><p>Speaker footage, biography requests, and practical answers about working together.</p><div class="actions"><a class="text-link" href="/media-kit/">Media & organizer resources ↗</a><a class="text-link" href="/faqs/">Read the FAQs ↗</a></div></article></div></div></section>
<section class="section wrap"><div class="resource-book"><Image src={book} alt="From Splintered to Centered book cover" width={183} height={275} format="webp" loading="lazy"/><div><p class="eyebrow">THE BOOK</p><h2>From Splintered<br/>to Centered</h2><p>Continue exploring Loren’s story through his book.</p><a class="text-link" href={site.book}>Explore the book ↗</a></div></div></section>
</Base>
<style>
.resource-show{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:72px;align-items:center}.resource-show-art{display:block;border:1px solid #494332;background:#060606}.resource-show-art img{width:100%;height:auto}.resource-show p:not(.eyebrow){max-width:530px;color:var(--muted)}.resource-links article{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1fr);gap:16px 56px;border-top:1px solid var(--line);padding-block:36px}.resource-links article:last-child{border-bottom:1px solid var(--line)}.resource-links h2{font-size:clamp(36px,3.5vw,52px);margin:0;grid-row:span 2}.resource-links p{margin:0}.resource-links .text-link{width:fit-content}.resource-links .actions{grid-column:2}.resource-book{display:flex;gap:56px;align-items:center}.resource-book>img{width:183px;height:auto;flex-shrink:0}.resource-book p:not(.eyebrow){color:var(--muted)}@media(max-width:767px){.resource-show,.resource-links article{grid-template-columns:1fr;gap:28px}.resource-show-art{max-width:420px}.resource-links h2{grid-row:auto}.resource-links .actions{grid-column:auto}.resource-book{gap:32px;align-items:start;flex-direction:column}.resource-book>img{width:150px}}
</style>
