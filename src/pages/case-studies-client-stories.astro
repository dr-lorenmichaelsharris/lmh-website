---
import Base from '../layouts/Base.astro';
import {Image} from 'astro:assets';
import PageIntro from '../components/PageIntro.astro';
import ApprovedContent from '../components/ApprovedContent.astro';
import workshop from '../assets/workshop.jpg';
---
<Base title="The context behind the work" description="Explore published audience and client experiences, and discuss relevant references for your event or coaching engagement.">
<PageIntro title="Every story has a context." eyebrow="CLIENT STORIES" description="An audience, an occasion, a question someone wants to work through. Start with the people and the circumstances behind the work."/>
<section class="section wrap"><div class="split"><figure class="reveal"><Image src={workshop} alt="Loren in conversation with workshop participants around a table" widths={[400,700,1000]} sizes="(max-width:767px) calc(100vw - 40px), 46vw" format="webp" loading="eager"/><figcaption class="metadata">A workshop from Loren’s published collection · Photograph: Raducu Popa</figcaption></figure><div><p class="eyebrow">FIRSTHAND ACCOUNTS</p><h2>Hear from the<br/>people who<br/><span class="gold-text">were there.</span></h2><p>Watch Robert A. Lane, Martha Glory, and Amy Joy describe their individual experiences working with Loren. Read audience and organizer accounts about preparation, connection, and delivery.</p><a class="button" href="/testimonials/">Explore their experiences ↗</a></div></div></section>
<ApprovedContent kind="caseStudies"/>
<section class="section light-section"><div class="wrap split"><div><p class="eyebrow">A RELEVANT REFERENCE</p><h2>Your setting matters.</h2></div><div><p>For references relevant to a specific event or engagement, include your audience, goals, and timing in an inquiry. The discussion begins with what you need.</p><div class="actions"><a class="button" href="/contact/?service=speaking">Discuss your event ↗</a><a class="text-link" href="/contact/?service=coaching">Discuss coaching ↗</a></div></div></div></section>
</Base>
