  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@astrojs/node": "11.1.8",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.1",
    "mysql2": "^3.24.6",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "cheerio": "1.2.0",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  },
  "packageManager": "pnpm@11.25.0"
