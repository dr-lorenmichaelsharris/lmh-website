{
  "name": "lmh-astro-rebuild",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "check": "astro check",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "verify": "node scripts/verify.mjs",
    "release:check": "node scripts/release-check.mjs",
    "test:browser": "node scripts/browser-qa.mjs",
    "test:http": "node scripts/http-flow-test.mjs",
    "test:deployment": "node scripts/deployment-smoke.mjs",
    "test:performance": "node scripts/performance.mjs",
    "start": "node ./dist/server/entry.mjs",
    "build:hostinger": "node scripts/build-hostinger.mjs"
